@page "/profile"
@using FamilyVault.Files.Security
@using McWutWebApp.Hosting
@model McWutWebApp.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Profile</h1>
    </div>
</div>

<div class="profile-sheet" id="profile-sheet"
     data-badge="@Model.Flair.HeaderBadge"
     data-motif="@Model.Flair.HeaderMotif"
     data-tile="@Model.Flair.BackgroundTile"
     data-chime="@Model.Flair.ChimeTheme"
     data-tag="@Model.Flair.StatusTag">
    @if (Model.Notice is not null)
    {
        <div class="alert alert-success">@Model.Notice</div>
    }

    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h6 mb-3">Name &amp; Color</h2>
            <form method="post" asp-page-handler="Profile" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="DisplayName">Name</label>
                        <input asp-for="DisplayName" class="form-control" maxlength="40" autocomplete="nickname" />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="StatusTag">Title <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="StatusTag" class="form-control" maxlength="30" placeholder="" autocomplete="off" />
                        <span asp-validation-for="StatusTag" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="AccentColor">Color</label>
                    <div class="color-field mb-2">
                        <input asp-for="AccentColor" type="color" class="color-pick" />
                        <span class="color-hex" id="color-hex">@Model.AccentColor</span>
                    </div>
                    <div class="color-swatches" role="group" aria-label="Color presets">
                        @foreach (var swatch in PersonalizationService.Swatches)
                        {
                            <button type="button" class="color-swatch-dot" data-color-preset="@swatch.Hex" aria-label="@swatch.Hex" title="@swatch.Hex" style="background-color: @swatch.Hex"></button>
                        }
                    </div>
                    <span asp-validation-for="AccentColor" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </section>

    <section class="card mb-3" id="header-studio">
        <div class="card-body">
            <h2 class="h6 mb-3">Emblem &amp; Motif</h2>

            <label class="form-label small fw-semibold text-uppercase text-muted">Emblem</label>
            <div class="flair-grid flair-grid-compact mb-3" id="badge-grid" role="group" aria-label="Emblem">
                @foreach (var p in PersonalizationService.BadgePresets)
                {
                    var active = string.Equals(Model.Flair.HeaderBadge, p.Value, StringComparison.OrdinalIgnoreCase);
                    <button type="button" class="flair-option @(active ? "active" : null)" data-flair-kind="badge" data-flair-value="@p.Value" aria-pressed="@(active ? "true" : "false")" aria-label="@p.Label" title="@p.Label">
                        @if (!string.IsNullOrEmpty(p.Url))
                        {
                            <img src="@p.Url" alt="" class="flair-thumb-badge" loading="lazy" />
                        }
                        else
                        {
                            <span class="flair-none">—</span>
                        }
                    </button>
                }
                @foreach (var c in Model.CustomSvgItems.Where(x => x.Kind == "badge"))
                {
                    var active = string.Equals(Model.Flair.HeaderBadge, c.Value, StringComparison.OrdinalIgnoreCase);
                    <div class="flair-custom-wrap">
                        <button type="button" class="flair-option @(active ? "active" : null)" data-flair-kind="badge" data-flair-value="@c.Value" aria-pressed="@(active ? "true" : "false")" aria-label="@c.Label" title="@c.Label">
                            <img src="@c.Url" alt="" class="flair-thumb-badge" loading="lazy" />
                        </button>
                        <button type="button" class="flair-delete" data-delete-svg="@c.Id" title="Delete" aria-label="Delete">×</button>
                    </div>
                }
            </div>

            <div class="flair-ai-box mb-4">
                <div class="flair-ai-row">
                    <select id="ai-badge-theme" class="form-select form-select-sm flair-theme-select" aria-label="Style">
                        @foreach (var t in StickerGeneratorRules.ProfileThemes)
                        {
                            <option value="@t.Id">@t.Label</option>
                        }
                    </select>
                    <input id="ai-badge-prompt" type="text" class="form-control form-control-sm flair-prompt-input" maxlength="50" placeholder="Prompt…" />
                    <button type="button" class="btn btn-sm btn-primary flair-gen-btn" id="ai-badge-btn" data-gen-kind="badge">Create</button>
                </div>
            </div>

            <label class="form-label small fw-semibold text-uppercase text-muted">Accent Motif</label>
            <div class="flair-grid flair-grid-wide mb-2" id="motif-grid" role="group" aria-label="Accent motif">
                @foreach (var p in PersonalizationService.MotifPresets)
                {
                    var active = string.Equals(Model.Flair.HeaderMotif, p.Value, StringComparison.OrdinalIgnoreCase);
                    <button type="button" class="flair-option flair-option-wide @(active ? "active" : null)" data-flair-kind="motif" data-flair-value="@p.Value" aria-pressed="@(active ? "true" : "false")" aria-label="@p.Label" title="@p.Label">
                        @if (!string.IsNullOrEmpty(p.Url))
                        {
                            <span class="flair-thumb-motif" style="background-image: url('@p.Url')"></span>
                        }
                        else
                        {
                            <span class="flair-none">—</span>
                        }
                    </button>
                }
                @foreach (var c in Model.CustomSvgItems.Where(x => x.Kind == "motif"))
                {
                    var active = string.Equals(Model.Flair.HeaderMotif, c.Value, StringComparison.OrdinalIgnoreCase);
                    <div class="flair-custom-wrap">
                        <button type="button" class="flair-option flair-option-wide @(active ? "active" : null)" data-flair-kind="motif" data-flair-value="@c.Value" aria-pressed="@(active ? "true" : "false")" aria-label="@c.Label" title="@c.Label">
                            <span class="flair-thumb-motif" style="background-image: url('@c.Url')"></span>
                        </button>
                        <button type="button" class="flair-delete" data-delete-svg="@c.Id" title="Delete" aria-label="Delete">×</button>
                    </div>
                }
            </div>

            <div class="flair-ai-box">
                <div class="flair-ai-row">
                    <select id="ai-motif-theme" class="form-select form-select-sm flair-theme-select" aria-label="Style">
                        @foreach (var t in StickerGeneratorRules.ProfileThemes)
                        {
                            <option value="@t.Id">@t.Label</option>
                        }
                    </select>
                    <input id="ai-motif-prompt" type="text" class="form-control form-control-sm flair-prompt-input" maxlength="50" placeholder="Prompt…" />
                    <button type="button" class="btn btn-sm btn-outline-primary flair-gen-btn" id="ai-motif-btn" data-gen-kind="motif">Create</button>
                </div>
            </div>
            <p id="header-studio-status" class="field-hint mt-2 mb-0" hidden></p>
        </div>
    </section>

    <section class="card mb-3" id="bg-studio">
        <div class="card-body">
            <h2 class="h6 mb-3">Pattern</h2>

            <div class="flair-grid flair-grid-tile mb-3" id="tile-grid" role="group" aria-label="Pattern">
                @foreach (var p in PersonalizationService.TilePresets)
                {
                    var active = string.Equals(Model.Flair.BackgroundTile, p.Value, StringComparison.OrdinalIgnoreCase);
                    <button type="button" class="flair-option @(active ? "active" : null)" data-flair-kind="tile" data-flair-value="@p.Value" aria-pressed="@(active ? "true" : "false")" aria-label="@p.Label" title="@p.Label">
                        @if (!string.IsNullOrEmpty(p.Url))
                        {
                            <span class="flair-thumb-tile" style="background-image: url('@p.Url')"></span>
                        }
                        else
                        {
                            <span class="flair-none">—</span>
                        }
                    </button>
                }
                @foreach (var c in Model.CustomSvgItems.Where(x => x.Kind == "tile"))
                {
                    var active = string.Equals(Model.Flair.BackgroundTile, c.Value, StringComparison.OrdinalIgnoreCase);
                    <div class="flair-custom-wrap">
                        <button type="button" class="flair-option @(active ? "active" : null)" data-flair-kind="tile" data-flair-value="@c.Value" aria-pressed="@(active ? "true" : "false")" aria-label="@c.Label" title="@c.Label">
                            <span class="flair-thumb-tile" style="background-image: url('@c.Url')"></span>
                        </button>
                        <button type="button" class="flair-delete" data-delete-svg="@c.Id" title="Delete" aria-label="Delete">×</button>
                    </div>
                }
            </div>

            <div class="flair-ai-box">
                <div class="flair-ai-row">
                    <select id="ai-tile-theme" class="form-select form-select-sm flair-theme-select" aria-label="Style">
                        @foreach (var t in StickerGeneratorRules.ProfileThemes)
                        {
                            <option value="@t.Id">@t.Label</option>
                        }
                    </select>
                    <input id="ai-tile-prompt" type="text" class="form-control form-control-sm flair-prompt-input" maxlength="50" placeholder="Prompt…" />
                    <button type="button" class="btn btn-sm btn-primary flair-gen-btn" id="ai-tile-btn" data-gen-kind="tile">Create</button>
                </div>
            </div>
            <p id="bg-studio-status" class="field-hint mt-2 mb-0" hidden></p>
        </div>
    </section>

    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h6 mb-3">Appearance &amp; Sound</h2>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="theme-choice" role="group" aria-label="Appearance">
                    <button type="button" class="btn btn-outline-secondary theme-btn" data-theme-value="light" aria-pressed="true">Light</button>
                    <button type="button" class="btn btn-outline-secondary theme-btn" data-theme-value="dark" aria-pressed="false">Dark</button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 small text-muted" for="chime-select">Sound</label>
                    <select id="chime-select" class="form-select form-select-sm" style="width: auto;">
                        @foreach (var (chimeId, chimeLabel) in PersonalizationService.ChimeThemes)
                        {
                            <option value="@chimeId" selected="@(Model.Flair.ChimeTheme == chimeId ? "selected" : null)">@chimeLabel</option>
                        }
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="chime-preview-btn">Test</button>
                </div>
            </div>
        </div>
    </section>

    @if (!Model.IsKid)
    {
        <section class="card mb-3" id="ai-key">
            <div class="card-body">
                <h2 class="h6 mb-3">AI Key</h2>
                <form id="ai-key-form" class="ai-key-form" method="post" autocomplete="off">
                    <div class="ai-key-field">
                        <label class="form-label visually-hidden" for="ai-key-input">OpenRouter key</label>
                        <input id="ai-key-input" name="openrouter-key" class="form-control" type="password" maxlength="200" autocomplete="off" spellcheck="false" placeholder="OpenRouter API key" />
                    </div>
                    <button type="submit" class="btn btn-primary" id="ai-key-save">Save</button>
                    <button type="button" class="btn btn-outline-secondary" id="ai-key-remove" hidden>Remove</button>
                </form>
                <p id="ai-key-status" class="field-hint mb-0">Loading…</p>
            </div>
        </section>
    }

    <section class="card mb-3" id="password">
        <div class="card-body">
            <h2 class="h6 mb-3">Password</h2>
            <form method="post" asp-page-handler="Password" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-3">
                    <label class="form-label" for="CurrentPassword">Current password</label>
                    <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="NewPassword">New password</label>
                    <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Save password</button>
            </form>
        </div>
    </section>

    <p class="mb-0"><a asp-page="/Privacy">Privacy</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/profile-flair.js" asp-append-version="true"></script>
    @if (!Model.IsKid)
    {
        <script src="~/js/ai-key.js" asp-append-version="true"></script>
    }
}

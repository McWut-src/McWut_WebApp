@page "/profile"
@model McWutWebApp.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Profile</h1>
        <p class="page-kicker">@(Model.IsKid ? "Your name, a color, and the password you use to sign in." : "Your name, a color, the password you use to sign in, and an AI key.")</p>
    </div>
</div>

<div class="profile-sheet">
    @if (Model.Notice is not null)
    {
        <div class="alert alert-success">@Model.Notice</div>
    }

    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h6 mb-3">Name and color</h2>
            <p class="field-hint mb-3">This color is the bar and the menu. A pale color uses dark text. A dark color uses pale text. The same color marks your name on a file you share. It is not shown on a public link.</p>
            <form method="post" asp-page-handler="Profile" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-3">
                    <label class="form-label" for="DisplayName">Name</label>
                    <input asp-for="DisplayName" class="form-control" maxlength="40" autocomplete="nickname" />
                    <span asp-validation-for="DisplayName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="AccentColor">Color</label>
                    <div class="color-field">
                        <input asp-for="AccentColor" type="color" class="color-pick" />
                        <span class="color-hex" id="color-hex">@Model.AccentColor</span>
                    </div>
                    <span asp-validation-for="AccentColor" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </section>

    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h6 mb-1">Appearance</h2>
            <p class="field-hint mb-3">Light or dark. This stays on this browser. The bar keeps your color.</p>
            <div class="theme-choice" role="group" aria-label="Appearance">
                <button type="button" class="btn btn-outline-secondary theme-btn" data-theme-value="light" aria-pressed="true">Light</button>
                <button type="button" class="btn btn-outline-secondary theme-btn" data-theme-value="dark" aria-pressed="false">Dark</button>
            </div>
        </div>
    </section>

    @if (!Model.IsKid)
    {
        <section class="card mb-3" id="ai-key">
            <div class="card-body">
                <h2 class="h6 mb-1">AI key</h2>
                <p class="field-hint mb-3">Your own key from <a href="https://openrouter.ai/settings/keys" target="_blank" rel="noopener">OpenRouter</a>. It is encrypted and not shared. The full key is not shown again. <a href="https://openrouter.ai/" target="_blank" rel="noopener">Create an account</a> if you need one.</p>
                <form id="ai-key-form" class="ai-key-form" method="post" autocomplete="off">
                    <div class="ai-key-field">
                        <label class="form-label" for="ai-key-input">OpenRouter key</label>
                        <input id="ai-key-input" name="openrouter-key" class="form-control" type="password" maxlength="200" autocomplete="off" spellcheck="false" placeholder="sk-or-v1-…" />
                    </div>
                    <button type="submit" class="btn btn-primary" id="ai-key-save">Save key</button>
                    <button type="button" class="btn btn-outline-secondary" id="ai-key-remove" hidden>Remove</button>
                </form>
                <p id="ai-key-status" class="field-hint mb-0">Loading…</p>
            </div>
        </section>
    }

    <section class="card mb-3" id="password">
        <div class="card-body">
            <h2 class="h6 mb-1">Sign-in password</h2>
            <p class="field-hint mb-3">This is the password you use to sign in, not a saved login. Use at least @Model.RequiredLength characters.</p>
            <form method="post" asp-page-handler="Password" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-3">
                    <label class="form-label" for="CurrentPassword">Current password</label>
                    <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="NewPassword">New password</label>
                    <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ConfirmPassword">Confirm new password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Save password</button>
            </form>
        </div>
    </section>

    <p class="mb-0"><a asp-page="/Privacy">Privacy</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!Model.IsKid)
    {
        <script src="~/js/ai-key.js" asp-append-version="true"></script>
    }
}

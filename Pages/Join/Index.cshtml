@page "/join/{token}"
@model McWutWebApp.Pages.Join.IndexModel
@{
    ViewData["Title"] = "Join McWut";
}

<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h5 mb-3">Join McWut</h1>
                <p class="text-muted small">This page only works with an invite link.</p>
                @if (Model.Error is not null)
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label" asp-for="Email">Email</label>
                        @if (Model.EmailLocked)
                        {
                            <input class="form-control" asp-for="Email" type="email" required readonly />
                        }
                        else
                        {
                            <input class="form-control" asp-for="Email" type="email" required />
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Password">Password</label>
                        <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="ConfirmPassword">Confirm password</label>
                        <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Create account</button>
                </form>
            </div>
        </div>
    </div>
</div>

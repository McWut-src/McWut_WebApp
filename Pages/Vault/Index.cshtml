@page
@model McWutWebApp.Pages.Vault.IndexModel
@{
    ViewData["Title"] = "Family vault";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Family vault</h1>
        <p class="text-muted mb-0">Drop files to share a link. Default expiry is 7 days.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Vault/Shared">Shared with me</a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">New drop</h2>
                <div id="dropzone" class="vault-dropzone mb-3">
                    <p class="mb-1 fw-semibold">Drag files here</p>
                    <p class="small text-muted mb-2">or click to choose</p>
                    <input id="file-input" type="file" multiple class="d-none" />
                    <button type="button" class="btn btn-sm btn-primary" id="pick-files">Choose files</button>
                    <ul id="file-list" class="small mt-3 mb-0"></ul>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="drop-title">Title</label>
                    <input id="drop-title" class="form-control" placeholder="Family photos" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label" for="ttl">Keep for</label>
                        <select id="ttl" class="form-select">
                            <option value="7" selected>7 days</option>
                            <option value="1">1 day</option>
                            <option value="30">30 days</option>
                            <option value="0">Forever</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="password">Password (optional)</label>
                        <input id="password" type="password" class="form-control" autocomplete="new-password" />
                    </div>
                </div>
                <button type="button" class="btn btn-success w-100" id="upload-btn" disabled>Upload and get link</button>
                <div id="upload-status" class="small mt-3" hidden></div>
                <div id="link-box" class="mt-3" hidden>
                    <label class="form-label">Share link</label>
                    <div class="input-group">
                        <input id="share-url" class="form-control" readonly />
                        <button type="button" class="btn btn-outline-primary" id="copy-link">Copy</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">My files</h2>
                <div id="my-files" class="table-responsive">
                    <p class="text-muted">Loading…</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/vault.js" asp-append-version="true"></script>
}

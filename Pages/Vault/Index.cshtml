@page "/files"
@model McWutWebApp.Pages.Vault.IndexModel
@{
    ViewData["Title"] = "My files";
}

<div class="page-head">
    <div>
        <h1 class="page-title">My files</h1>
        <p class="page-kicker">Drop a file or paste a note.</p>
    </div>
</div>

<div class="workspace">
    <section class="composer card">
        <div class="card-body">
            <h2 class="h6 mb-3">New drop</h2>
            <div id="dropzone" class="vault-dropzone mb-3">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V6"/><path d="M8 9l4-4 4 4"/><path d="M5 19h14"/></svg>
                <p class="mb-1 fw-semibold">Drop files</p>
                <p class="small text-muted mb-2">or choose from this device</p>
                <input id="file-input" type="file" multiple class="d-none" />
                <button type="button" class="btn btn-sm btn-primary" id="pick-files">Choose files</button>
                <ul id="file-list" class="small mt-3 mb-0"></ul>
            </div>
            <div class="mb-3">
                <label class="form-label" for="paste-text">Paste text</label>
                <textarea id="paste-text" class="form-control" rows="4" placeholder="A note, a list, a snippet"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="drop-title">Title</label>
                <input id="drop-title" class="form-control" placeholder="Photos" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label" for="ttl">Keep for</label>
                    <select id="ttl" class="form-select">
                        <option value="7" selected>7 days</option>
                        <option value="1">1 day</option>
                        <option value="30">30 days</option>
                        <option value="0">Forever</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label" for="password">Link password</label>
                    <input id="password" type="password" class="form-control" autocomplete="new-password" />
                </div>
            </div>
            <button type="button" class="btn btn-primary w-100" id="upload-btn" disabled>Upload</button>
            <div id="upload-status" class="small mt-3" hidden></div>
            <div id="link-box" class="mt-3" hidden>
                <label class="form-label" for="share-url">Share link</label>
                <div class="input-group">
                    <input id="share-url" class="form-control" readonly />
                    <button type="button" class="btn btn-outline-primary" id="copy-link" aria-label="Copy link" title="Copy link">Copy</button>
                </div>
            </div>
        </div>
    </section>
    <section class="browser card">
        <div class="card-body">
            <div class="browser-bar">
                <label class="search-field">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>
                    <input id="file-search" type="search" placeholder="Search files" autocomplete="off" aria-label="Search files" />
                </label>
                <button type="button" class="icon-btn" id="file-refresh" title="Refresh" aria-label="Refresh">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.2-5.5"/><path d="M20 4v5h-5"/></svg>
                </button>
            </div>
            <div id="my-files">
                <p class="empty">Loading…</p>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/reader.js" asp-append-version="true"></script>
    <script src="~/js/vault.js" asp-append-version="true"></script>
}

@page "/passwords"
@model McWutWebApp.Pages.Passwords.IndexModel
@{
    ViewData["Title"] = "Passwords";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Passwords</h1>
        <p class="text-muted mb-0">Your logins only. Other members cannot open this list.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Account/Password">Change sign-in password</a>
</div>

<div class="password-search mb-3">
    <input id="password-search" class="form-control" type="search" placeholder="Search name, username, URL, or notes" autocomplete="off" />
    <button type="button" class="btn btn-primary" id="password-new">New</button>
</div>

<div class="password-shell">
    <div id="password-list" class="password-list" role="listbox" aria-label="Saved logins">
        <p class="text-muted p-3 mb-0">Loading…</p>
    </div>
    <div id="password-detail" class="password-detail card shadow-sm">
        <div class="card-body">
            <p class="text-muted mb-0">Select a login, or create one.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/passwords.js" asp-append-version="true"></script>
}

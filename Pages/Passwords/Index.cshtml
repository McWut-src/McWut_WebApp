@page "/passwords"
@model McWutWebApp.Pages.Passwords.IndexModel
@{
    ViewData["Title"] = "Password vault";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Password vault</h1>
        <p class="page-kicker">Your logins only. Other members cannot open this list.</p>
    </div>
</div>

<div class="password-toolbar">
    <label class="search-field">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>
        <input id="password-search" type="search" placeholder="Search name, username, URL, or notes" autocomplete="off" aria-label="Search logins" />
    </label>
    <button type="button" class="btn btn-primary" id="password-new">New</button>
</div>

<div class="password-shell">
    <div id="password-list" class="password-list" role="listbox" aria-label="Saved logins">
        <p class="empty">Loading…</p>
    </div>
    <div id="password-detail" class="password-detail card">
        <div class="card-body">
            <p class="empty">Select a login, or create one.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/passwords.js" asp-append-version="true"></script>
}

@page "/s/{token}"
@model McWutWebApp.Pages.Share.IndexModel
@{
    ViewData["Title"] = "Share";
}

<div class="page-head">
    <h1 class="page-title">@(Model.Drop?.Title ?? Model.Files.FirstOrDefault()?.OriginalFileName ?? "Share")</h1>
</div>

@if (Model.RequiresPassword)
{
    <div class="card shadow-sm" style="max-width: 28rem;">
        <div class="card-body">
            <p>This share is password protected.</p>
            @if (Model.Error is not null)
            {
                <div class="alert alert-danger">@Model.Error</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input id="password" name="Password" type="password" class="form-control" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn btn-primary">Unlock</button>
            </form>
        </div>
    </div>
}
else
{
    <p class="text-muted">@Model.Files.Count file(s)</p>
    @if (Model.Drop is not null)
    {
        <p>
            <a class="btn btn-outline-primary" href="/api/drops/@Model.Drop.Id/archive?token=@Model.Token">Download all</a>
        </p>
    }
    <ul class="list-group shadow-sm">
        @foreach (var file in Model.Files)
        {
            <li class="list-group-item">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div class="flex-grow-1">
                        @if (McWutWebApp.Hosting.PreviewTypes.IsImage(file.ContentType) && Model.Link?.AllowPreview == true)
                        {
                            <img class="share-preview mb-2" alt="" src="/api/files/@file.Id/content?preview=true&token=@Model.Token" />
                        }
                        <div>@file.OriginalFileName <span class="text-muted small">(@file.ContentType)</span></div>
                        @if (Model.Notes.TryGetValue(file.Id, out var note))
                        {
                            if (!string.IsNullOrEmpty(note.Notice))
                            {
                                <p class="note-skip">@note.Notice</p>
                            }
                            if (note.Text is not null && note.Markdown)
                            {
                                <div class="md-read" data-markdown>
                                    <pre class="md-source">@note.Text</pre>
                                </div>
                            }
                            else if (note.Text is not null)
                            {
                                <pre class="note-body">@note.Text</pre>
                            }
                        }
                    </div>
                    <a class="btn btn-sm btn-primary" href="/api/files/@file.Id/content?token=@Model.Token">Download</a>
                </div>
            </li>
        }
    </ul>
}

@section Scripts {
    <script src="~/js/reader.js" asp-append-version="true"></script>
}

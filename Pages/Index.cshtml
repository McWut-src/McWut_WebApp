@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="home">
    <div class="page-head">
        <div>
            <h1 class="page-title">McWut</h1>
            <p class="page-kicker">Files, public links, and a private password vault for people you invite.</p>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="card" style="max-width: 28rem;">
            <div class="card-body">
                @if (Model.ShowDevCredentials)
                {
                    <h2 class="h6">Dev sign-in</h2>
                    <p class="text-muted">This is a local project. Passwords are simple on purpose.</p>
                    <ul>
                        <li><strong>vince@mcwut.com</strong> / <strong>vince</strong> (admin)</li>
                        <li><strong>member@mcwut.com</strong> / <strong>member</strong></li>
                    </ul>
                }
                <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
            </div>
        </div>
    }
</div>

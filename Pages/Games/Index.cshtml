                            </button>
                            <button type="button" class="btn btn-outline-light" id="n2048-win-again-btn">
                                Play Again
                            </button>
                        </div>
                    </div>
                </div>

                <div class="game-overlay" id="n2048-over-overlay" hidden>
                    <div class="game-overlay-card is-gameover">
                        <div class="game-record-banner" id="n2048-record-banner" hidden>

                        🏆 Official Track
                    </button>
                    <button type="button" class="ww-mode-tab" id="ww-tab-levels" data-ww-mode="levels" role="tab" aria-selected="false">
                        🌐 Member Levels <span class="ww-count-badge" id="ww-levels-count">0</span>
                    </button>
                    <button type="button" class="ww-mode-tab" id="ww-tab-editor" data-ww-mode="editor" role="tab" aria-selected="false">
                        🛠 Level Editor
                    </button>
                </div>
                <div class="ww-custom-playing-bar" id="ww-custom-playing-bar" hidden>
                    <span class="ww-custom-playing-label">
                        Course: <strong id="ww-custom-title-label">Custom</strong>
                    </span>
                    <span id="ww-custom-author-slot"></span>
                    <button type="button" class="btn btn-sm ww-mini-btn" id="ww-share-level-btn" title="Copy direct link to share with members">
                        🔗 Share
                    </button>
                    <button type="button" class="btn btn-sm ww-mini-btn" id="ww-remix-active-btn" title="Open a copy in Level Editor">
                        ⎘ Remix
                    </button>

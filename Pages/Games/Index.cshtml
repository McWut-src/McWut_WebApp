                        <h3 class="game-overlay-title" id="ww-start-title">Wacky Wheels</h3>
                        <p class="game-overlay-desc" id="ww-start-desc">
                            Balance your spring-loaded stunt buggy across rolling hills, launch ramps, a 360° loop-the-loop, springboards, crates, and swinging wrecking balls! Land flips for combo multipliers — or hit <strong>Eject</strong> to fling your toy rider across the finish gate!
                        </p>
                        <div class="d-flex gap-2 justify-content-center flex-wrap mb-2">
                            <button type="button" class="btn btn-primary game-play-btn" id="ww-start-btn">
                                Play Wacky Wheels
                            </button>
                        </div>
                        <div class="d-flex gap-2 justify-content-center flex-wrap mb-2">
                            <button type="button" class="btn btn-sm btn-outline-light" id="ww-open-levels-btn">
                                🌐 Member Levels
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-light" id="ww-open-editor-btn">
                                🛠 Build a Level
                            </button>
                        </div>
                        <div class="game-overlay-keys">
                            <span><kbd>W</kbd>/<kbd>↑</kbd> Gas · <kbd>S</kbd>/<kbd>↓</kbd> Brake</span>
                            <span><kbd>A</kbd>/<kbd>D</kbd> or <kbd>←</kbd>/<kbd>→</kbd> Lean / Flip</span>
                            <span><kbd>Space</kbd> Eject / Boost · <kbd>R</kbd> Restart</span>
                        </div>
                    </div>
                </div>

                <div class="game-overlay" id="ww-over-overlay" hidden>
                    <div class="game-overlay-card is-gameover" role="dialog" aria-labelledby="ww-over-title">
                        <div class="game-record-banner" id="ww-record-banner" hidden>
                            NEW PERSONAL RECORD!
                        </div>
                        <div class="game-overlay-badge" id="ww-over-badge">COURSE COMPLETE!</div>
                        <h3 class="game-overlay-title" id="ww-over-title">Checkered Flag!</h3>
                        <p class="game-overlay-desc mb-2" id="ww-over-breakdown"></p>
                        <div class="game-over-grid">
                            <div class="game-over-stat">
                                <span class="game-over-label">Score</span>
                                <strong class="game-over-val is-primary" id="ww-over-score">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Max Combo</span>
                                <strong class="game-over-val" id="ww-over-combo">×0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label" id="ww-over-best-label">Your Best</span>
                                <strong class="game-over-val" id="ww-over-best">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label" id="ww-over-rank-label">Global Rank</span>
                                <strong class="game-over-val" id="ww-over-rank">—</strong>
                            </div>
                        </div>
                        <p class="game-save-status" id="ww-save-status">Saving score…</p>
                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                            <button type="button" class="btn btn-primary game-play-btn" id="ww-again-btn">
                                Play Again
                            </button>
                            <button type="button" class="btn btn-outline-light" id="ww-over-edit-btn" hidden>
                                ✎ Back to Editor
                            </button>
                            <button type="button" class="btn btn-success" id="ww-over-publish-btn" hidden>
                                🚀 Publish Level
                            </button>
                            <button type="button" class="btn btn-outline-light" id="ww-over-levels-btn" hidden>
                                🌐 Member Levels
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Member Levels Community Browser Overlay -->
                <div class="game-overlay" id="ww-levels-overlay" hidden>
                    <div class="game-overlay-card ww-levels-card" role="dialog" aria-labelledby="ww-levels-heading">
                        <div class="ww-levels-head">
                            <div>
                                <h3 class="h5 mb-0 text-white fw-bold" id="ww-levels-heading">🌐 Member Stunt Levels</h3>
                                <span class="small text-white-50">Play obstacle courses created by members or build your own!</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-primary" id="ww-levels-new-btn">
                                    + Create Level
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-light" id="ww-levels-close-btn" aria-label="Close Member Levels">
                                    ✕
                                </button>
                            </div>
                        </div>
                        <div class="ww-levels-list" id="ww-levels-list">
                            <p class="text-white-50 small mb-0">Loading member levels…</p>
                        </div>
                    </div>
                </div>

                <!-- Publish Custom Level Dialog Overlay -->

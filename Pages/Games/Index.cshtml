@page "/games"
@model McWutWebApp.Pages.Games.IndexModel
@{
    ViewData["Title"] = "Games";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Games</h1>
        <p class="page-kicker">Play solo in this browser and chase the global high score.</p>
    </div>
</div>

<div class="game-hub-strip" id="game-hub-strip" role="tablist" aria-label="Arcade games">
    <button type="button" class="game-hub-card is-active" data-game-key="stack-3d" role="tab" aria-selected="true">
        <div class="game-hub-icon is-stack" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
                <polygon points="16,4 28,10 16,16 4,10" fill="#38bdf8" />
                <polygon points="4,10 16,16 16,21 4,15" fill="#0284c7" />
                <polygon points="28,10 16,16 16,21 28,15" fill="#0369a1" />
                <polygon points="16,13 26,18 16,23 6,18" fill="#a855f7" opacity="0.9" />
                <polygon points="6,18 16,23 16,28 6,23" fill="#7e22ce" />
                <polygon points="26,18 16,23 16,28 26,23" fill="#6b21a8" />
            </svg>
        </div>
        <div class="game-hub-info">
            <div class="game-hub-title-row">
                <strong>Stack 3D</strong>
                <span class="game-hub-tag is-live">Three.js 3D</span>
            </div>
            <span>Slice overhangs, land perfect drops, and build the highest tower.</span>
        </div>
    </button>

    <button type="button" class="game-hub-card" data-game-key="mini-crossword" role="tab" aria-selected="false">
        <div class="game-hub-icon is-crossword" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
                <rect x="4" y="4" width="11" height="11" rx="2.5" fill="#f43f5e" />
                <rect x="17" y="4" width="11" height="11" rx="2.5" fill="#fb7185" opacity="0.85" />
                <rect x="4" y="17" width="11" height="11" rx="2.5" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
                <rect x="17" y="17" width="11" height="11" rx="2.5" fill="#f59e0b" />
                <text x="9.5" y="12.5" text-anchor="middle" fill="#ffffff" font-size="8" font-weight="800" font-family="sans-serif">A</text>
                <text x="22.5" y="12.5" text-anchor="middle" fill="#ffffff" font-size="8" font-weight="800" font-family="sans-serif">B</text>
                <text x="22.5" y="25.5" text-anchor="middle" fill="#ffffff" font-size="8" font-weight="800" font-family="sans-serif">C</text>
            </svg>
        </div>
        <div class="game-hub-info">
            <div class="game-hub-title-row">
                <strong>Mini Crossword</strong>
                <span class="game-hub-tag is-live">5×5 Grid</span>
            </div>
            <span>Bite-sized 5×5 crossword pack with smart clues, pencil mode, and speed bonuses.</span>
        </div>
    </button>

    <button type="button" class="game-hub-card" data-game-key="minesweeper" role="tab" aria-selected="false">
        <div class="game-hub-icon is-minesweeper" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
                <path d="M4 10h24M4 16h24M4 22h24M10 4v24M16 4v24M22 4v24" stroke="#38bdf8" stroke-width="0.8" opacity="0.14" />
                <circle cx="16" cy="18" r="5.6" fill="#111c2e" stroke="#fb7185" stroke-width="1.7" />
                <path d="M16 9.6V6.4M16 29.6v-3.2M6.4 18H3.2M28.8 18h-3.2M9.3 11.3l-2.2-2.2M22.7 11.3l2.2-2.2M9.3 24.7l-2.2 2.2M22.7 24.7l2.2 2.2" stroke="#fb7185" stroke-width="1.7" stroke-linecap="round" />
                <circle cx="16" cy="18" r="2.2" fill="#f43f5e" />
                <path d="M19.2 14.8l2-2" stroke="#fbbf24" stroke-width="1.6" stroke-linecap="round" />
                <circle cx="21.8" cy="12.2" r="1.1" fill="#fbbf24" />
            </svg>
        </div>
        <div class="game-hub-info">
            <div class="game-hub-title-row">
                <strong>Minesweeper</strong>
                <span class="game-hub-tag is-live">Canvas 2D</span>
            </div>
            <span>Clear the neon minefield. Chain cascades, dodge explosions, and top the board.</span>
        </div>
    </button>

    <button type="button" class="game-hub-card" data-game-key="neon-slope" role="tab" aria-selected="false">
        <div class="game-hub-icon is-slope" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
                <path d="M4 26L13 8h6l9 18" stroke="#22d3ee" stroke-width="2" stroke-linecap="round"/>
                <circle cx="16" cy="19" r="4.5" fill="#f43f5e"/>
            </svg>
        </div>
        <div class="game-hub-info">
            <div class="game-hub-title-row">
                <strong>Neon Slope</strong>
                <span class="game-hub-tag is-live">Three.js 3D</span>
            </div>
            <span>High-speed 3D endless tunnel dodge.</span>
        </div>
    </button>

    <button type="button" class="game-hub-card" data-game-key="merge-2048" role="tab" aria-selected="false">
        <div class="game-hub-icon is-2048" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
                <rect x="5" y="5" width="10" height="10" rx="2.5" fill="#f59e0b"/>
                <rect x="17" y="5" width="10" height="10" rx="2.5" fill="#fbbf24" opacity="0.65"/>
                <rect x="5" y="17" width="10" height="10" rx="2.5" fill="#fbbf24" opacity="0.4"/>
                <rect x="17" y="17" width="10" height="10" rx="2.5" fill="#10b981"/>
            </svg>
        </div>
        <div class="game-hub-info">
            <div class="game-hub-title-row">
                <strong>2048 Neon</strong>
                <span class="game-hub-tag is-live">Neon Grid</span>
            </div>
            <span>Reactive number-merging grid puzzle.</span>
        </div>
    </button>
</div>

<div class="games-workspace">
    <section class="card game-stage-card" aria-label="Arcade Game Stage">
        <div class="game-stage-header">
            <div class="game-stage-title-wrap">
                <h2 class="h6 mb-0" id="game-active-title">Stack 3D</h2>
                <span class="game-stage-hint" id="game-stage-hint">Click, tap, or press <kbd>Space</kbd> to drop</span>
            </div>
            <div class="game-stage-controls">
                <span class="game-stat-pill" id="game-my-best" title="Your personal high score">Best: <strong>0</strong></span>
                <span class="game-stat-pill" id="game-my-rank" title="Your global rank">Rank: <strong>—</strong></span>
                <button type="button" class="icon-btn" id="game-mute-btn" title="Mute sound" aria-label="Mute sound" aria-pressed="false"></button>
                <button type="button" class="icon-btn" id="game-restart-btn" title="Restart game (R)" aria-label="Restart game"></button>
            </div>
        </div>

        <div class="game-viewport-wrap" id="stack-viewport">
            <canvas id="stack-canvas" aria-label="Stack 3D interactive canvas"></canvas>

            <div class="game-hud" aria-live="polite">
                <div class="game-hud-top">
                    <div class="game-hud-target" id="hud-target" hidden>
                        <span class="game-hud-target-label" id="hud-target-label">Leader</span>
                        <span class="game-hud-target-pill" id="hud-target-pill"></span>
                    </div>
                    <div class="game-hud-speed" id="hud-speed-pill">1.0× Speed</div>
                </div>

                <div class="game-hud-center">
                    <div class="game-hud-score" id="hud-score">0</div>
                    <div class="game-hud-combo" id="hud-combo" hidden>PERFECT ×1</div>
                    <div class="game-hud-pop" id="hud-pop" hidden>PERFECT!</div>
                </div>
            </div>

            <div class="game-overlay" id="stack-start-overlay">
                <div class="game-overlay-card">
                    <div class="game-overlay-badge">THREE.JS ARCADE</div>
                    <h3 class="game-overlay-title">Stack 3D</h3>
                    <p class="game-overlay-desc">
                        Time your drop to stack moving neon slabs. Overhanging edges get sliced off!
                        Land <strong>3+ Perfect Drops</strong> in a row to expand your slab back out.
                    </p>
                    <button type="button" class="btn btn-primary game-play-btn" id="stack-start-btn">
                        Play Stack 3D
                    </button>
                    <div class="game-overlay-keys">
                        <span><kbd>Space</kbd> / <kbd>Click</kbd> / <kbd>Tap</kbd> Drop</span>
                        <span><kbd>R</kbd> Quick Restart</span>
                    </div>
                </div>
            </div>

            <div class="game-overlay" id="stack-over-overlay" hidden>
                <div class="game-overlay-card is-gameover">
                    <div class="game-record-banner" id="over-record-banner" hidden>
                        NEW PERSONAL RECORD!
                    </div>
                    <h3 class="game-overlay-title">Tower Complete</h3>
                    <div class="game-over-grid">
                        <div class="game-over-stat">
                            <span class="game-over-label">Score</span>
                            <strong class="game-over-val is-primary" id="over-score">0</strong>
                        </div>
                        <div class="game-over-stat">
                            <span class="game-over-label">Max Combo</span>
                            <strong class="game-over-val" id="over-combo">×0</strong>
                        </div>
                        <div class="game-over-stat">
                            <span class="game-over-label">Your Best</span>
                            <strong class="game-over-val" id="over-best">0</strong>
                        </div>
                        <div class="game-over-stat">
                            <span class="game-over-label">Global Rank</span>
                            <strong class="game-over-val" id="over-rank">—</strong>
                        </div>
                    </div>
                    <p class="game-save-status" id="over-save-status">Saving score…</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-primary game-play-btn" id="stack-again-btn">
                            Play Again
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="cw-stage" id="crossword-stage" hidden>
            <div class="cw-toolbar">
                <div class="cw-puzzle-picker">
                    <label for="cw-puzzle-select" class="cw-picker-label">Puzzle</label>
                    <select id="cw-puzzle-select" class="form-select form-select-sm cw-select" aria-label="Choose crossword puzzle"></select>
                    <span class="cw-solved-pill" id="cw-solved-pill" hidden>✓ Solved</span>
                </div>
                <div class="cw-toolbar-right">
                    <span class="cw-timer-pill" id="cw-timer" title="Elapsed solve time">0:00</span>
                    <span class="cw-score-pill" id="cw-live-score" title="Projected speed + accuracy score">500 pts</span>
                    <button type="button" class="btn btn-sm cw-tool-btn" id="cw-pencil-btn" aria-pressed="false" title="Toggle pencil draft letters">
                        ✎ Pencil
                    </button>
                    <button type="button" class="btn btn-sm cw-tool-btn" id="cw-check-btn" title="Check filled letters">
                        ✓ Check
                    </button>
                    <button type="button" class="btn btn-sm cw-tool-btn" id="cw-hint-btn" title="Reveal active letter (-40 pts)">
                        💡 Hint
                    </button>
                </div>
            </div>

            <div class="cw-layout">
                <div class="cw-board-col">
                    <div class="cw-grid" id="cw-grid" role="grid" aria-label="5 by 5 Mini Crossword Grid"></div>

                    <div class="cw-clue-bar" id="cw-clue-bar">
                        <button type="button" class="cw-clue-nav" id="cw-prev-clue" aria-label="Previous clue" title="Previous clue">‹</button>
                        <button type="button" class="cw-active-clue" id="cw-active-clue" title="Tap to switch Across / Down">
                            <span class="cw-active-clue-tag" id="cw-active-clue-tag">1A</span>
                            <span class="cw-active-clue-text" id="cw-active-clue-text">Select a square to begin</span>
                        </button>
                        <button type="button" class="cw-clue-nav" id="cw-next-clue" aria-label="Next clue" title="Next clue">›</button>
                    </div>

                    <div class="cw-keyboard" id="cw-keyboard" aria-label="On-screen crossword keyboard">
                        <div class="cw-kb-row">
                            <button type="button" class="cw-key" data-key="Q">Q</button>
                            <button type="button" class="cw-key" data-key="W">W</button>
                            <button type="button" class="cw-key" data-key="E">E</button>
                            <button type="button" class="cw-key" data-key="R">R</button>
                            <button type="button" class="cw-key" data-key="T">T</button>
                            <button type="button" class="cw-key" data-key="Y">Y</button>
                            <button type="button" class="cw-key" data-key="U">U</button>
                            <button type="button" class="cw-key" data-key="I">I</button>
                            <button type="button" class="cw-key" data-key="O">O</button>
                            <button type="button" class="cw-key" data-key="P">P</button>
                        </div>
                        <div class="cw-kb-row">
                            <button type="button" class="cw-key" data-key="A">A</button>
                            <button type="button" class="cw-key" data-key="S">S</button>
                            <button type="button" class="cw-key" data-key="D">D</button>
                            <button type="button" class="cw-key" data-key="F">F</button>
                            <button type="button" class="cw-key" data-key="G">G</button>
                            <button type="button" class="cw-key" data-key="H">H</button>
                            <button type="button" class="cw-key" data-key="J">J</button>
                            <button type="button" class="cw-key" data-key="K">K</button>
                            <button type="button" class="cw-key" data-key="L">L</button>
                        </div>
                        <div class="cw-kb-row">
                            <button type="button" class="cw-key is-wide" data-key="DIR" title="Switch Across / Down">⇄ Dir</button>
                            <button type="button" class="cw-key" data-key="Z">Z</button>
                            <button type="button" class="cw-key" data-key="X">X</button>
                            <button type="button" class="cw-key" data-key="C">C</button>
                            <button type="button" class="cw-key" data-key="V">V</button>
                            <button type="button" class="cw-key" data-key="B">B</button>
                            <button type="button" class="cw-key" data-key="N">N</button>
                            <button type="button" class="cw-key" data-key="M">M</button>
                            <button type="button" class="cw-key is-wide" data-key="BACKSPACE" aria-label="Backspace">⌫</button>
                        </div>
                    </div>
                </div>

                <div class="cw-clues-col">
                    <div class="cw-clue-group">
                        <h3 class="cw-clue-heading">Across</h3>
                        <div class="cw-clue-list" id="cw-clues-across"></div>
                    </div>
                    <div class="cw-clue-group">
                        <h3 class="cw-clue-heading">Down</h3>
                        <div class="cw-clue-list" id="cw-clues-down"></div>
                    </div>
                </div>
            </div>

            <div class="game-overlay" id="cw-win-overlay" hidden>
                <div class="game-overlay-card is-gameover">
                    <div class="game-record-banner" id="cw-record-banner" hidden>
                        NEW PERSONAL RECORD!
                    </div>
                    <div class="game-overlay-badge">PUZZLE COMPLETE</div>
                    <h3 class="game-overlay-title" id="cw-win-title">Mini Solved!</h3>
                    <div class="game-over-grid">
                        <div class="game-over-stat">
                            <span class="game-over-label">Score</span>
                            <strong class="game-over-val is-primary" id="cw-win-score">0</strong>
                        </div>
                        <div class="game-over-stat">
                            <span class="game-over-label">Solve Time</span>
                            <strong class="game-over-val" id="cw-win-time">0:00</strong>
                        </div>
                        <div class="game-over-stat">
                            <span class="game-over-label">Your Best</span>
                            <strong class="game-over-val" id="cw-win-best">0</strong>
                        </div>
                        <div class="game-over-stat">
                            <span class="game-over-label">Global Rank</span>
                            <strong class="game-over-val" id="cw-win-rank">—</strong>
                        </div>
                    </div>
                    <p class="game-save-status" id="cw-save-status">Saving score…</p>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <button type="button" class="btn btn-primary game-play-btn" id="cw-next-puzzle-btn">
                            Next Puzzle →
                        </button>
                        <button type="button" class="btn btn-outline-light" id="cw-replay-btn">
                            Replay
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="ms-stage" id="minesweeper-stage" hidden>
            <div class="ms-toolbar">
                <div class="ms-diff-group" id="ms-diff-group" role="group" aria-label="Minefield difficulty">
                    <button type="button" class="ms-diff-btn is-active" data-ms-diff="easy" aria-pressed="true">
                        Easy <span>9×9</span>
                    </button>
                    <button type="button" class="ms-diff-btn" data-ms-diff="medium" aria-pressed="false">
                        Medium <span>14×18</span>
                    </button>
                    <button type="button" class="ms-diff-btn" data-ms-diff="hard" aria-pressed="false">
                        Hard <span>16×24</span>
                    </button>
                </div>

                <div class="ms-toolbar-stats" aria-live="off">
                    <span class="game-stat-pill ms-stat-pill" title="Mines remaining">
                        <svg class="ms-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="14" r="4.4" />
                            <path d="M12 9.6V6.8M12 21.2v-2.8M7.6 14H4.8M19.2 14h-2.8M8.9 10.9 6.9 8.9M15.1 10.9l2-2M8.9 17.1l-2 2M15.1 17.1l2 2" />
                        </svg>
                        <strong id="ms-mines-left">10</strong>
                    </span>
                    <span class="game-stat-pill ms-stat-pill" title="Elapsed time">
                        <svg class="ms-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="13" r="7.2" />
                            <path d="M12 9.5V13l2.4 1.6" />
                            <path d="M9.5 3h5" />
                        </svg>
                        <strong id="ms-timer">0:00</strong>
                    </span>
                    <span class="game-stat-pill ms-stat-pill is-score" title="Current score">
                        Score <strong id="ms-score">0</strong>
                    </span>
                </div>

                <button type="button" class="btn btn-sm ms-flag-btn" id="ms-flag-btn" aria-pressed="false" title="Toggle flag mode (F)" aria-label="Toggle flag mode">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 21V4" />
                        <path d="M5 4h13l-2.2 4.5L18 13H5" />
                    </svg>
                    <span>Flag</span>
                </button>
            </div>

            <div class="ms-arena" id="ms-arena">
                <canvas id="ms-canvas" tabindex="0" aria-label="Minesweeper minefield. Tap to reveal. Long press, right-click, or use flag mode to mark mines."></canvas>
                <p class="visually-hidden" id="ms-live-status" aria-live="polite"></p>

                <div class="game-overlay" id="ms-start-overlay">
                    <div class="game-overlay-card">
                        <div class="game-overlay-badge">CANVAS 2D ARCADE</div>
                        <h3 class="game-overlay-title">Minesweeper</h3>
                        <p class="game-overlay-desc">
                            Clear every safe tile without detonating the field. Wide-open cascades chain score,
                            and one wrong tap sets off a full particle chain reaction.
                        </p>
                        <button type="button" class="btn btn-primary game-play-btn" id="ms-start-btn">
                            Play Minesweeper
                        </button>
                        <div class="game-overlay-keys">
                            <span><kbd>Tap</kbd> / <kbd>Click</kbd> Reveal</span>
                            <span><kbd>Long press</kbd> / <kbd>Right-click</kbd> Flag</span>
                            <span><kbd>F</kbd> Flag mode</span>
                        </div>
                    </div>
                </div>

                <div class="game-overlay" id="ms-over-overlay" hidden>
                    <div class="game-overlay-card is-gameover" role="dialog" aria-labelledby="ms-over-title">
                        <div class="game-record-banner" id="ms-record-banner" hidden>
                            NEW PERSONAL RECORD!
                        </div>
                        <div class="game-overlay-badge" id="ms-over-badge">MINEFIELD CLEARED</div>
                        <h3 class="game-overlay-title" id="ms-over-title">Swept Clean!</h3>
                        <div class="game-over-grid">
                            <div class="game-over-stat">
                                <span class="game-over-label">Score</span>
                                <strong class="game-over-val is-primary" id="ms-over-score">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Time</span>
                                <strong class="game-over-val" id="ms-over-time">0:00</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Best Cascade</span>
                                <strong class="game-over-val" id="ms-over-combo">—</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Global Rank</span>
                                <strong class="game-over-val" id="ms-over-rank">—</strong>
                            </div>
                        </div>
                        <p class="game-save-status" id="ms-save-status">Saving score…</p>
                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                            <button type="button" class="btn btn-primary game-play-btn" id="ms-again-btn">
                                Play Again
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="slope-stage" id="slope-stage" hidden>
            <div class="slope-viewport-wrap" id="slope-viewport">
                <canvas id="slope-canvas" aria-label="Neon Slope 3D endless runner"></canvas>

                <div class="game-hud" aria-live="polite">
                    <div class="game-hud-top">
                        <div class="game-hud-target" id="slope-target" hidden>
                            <span class="game-hud-target-label" id="slope-target-label">Leader</span>
                            <span class="game-hud-target-pill" id="slope-target-pill"></span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="slope-gem-pill" id="slope-gem-pill" title="Crystals collected">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="slope-gem-icon"><polygon points="12,2 22,8.5 12,22 2,8.5" fill="#22d3ee" fill-opacity="0.3"/></svg>
                                <strong id="slope-gems-count">0</strong>
                            </span>
                            <div class="game-hud-speed" id="slope-speed-pill">1.0× Speed</div>
                        </div>
                    </div>

                    <div class="game-hud-center">
                        <div class="game-hud-score" id="slope-score">0</div>
                        <div class="game-hud-combo" id="slope-combo" hidden>DODGE ×1</div>
                        <div class="game-hud-pop" id="slope-pop" hidden>SPEED BOOST!</div>
                    </div>
                </div>

                <div class="slope-touch-zones" aria-hidden="true">
                    <button type="button" class="slope-touch-btn is-left" id="slope-touch-left" title="Steer Left">◀</button>
                    <button type="button" class="slope-touch-btn is-jump" id="slope-touch-jump" title="Jump">▲ Jump</button>
                    <button type="button" class="slope-touch-btn is-right" id="slope-touch-right" title="Steer Right">▶</button>
                </div>

                <div class="game-overlay" id="slope-start-overlay">
                    <div class="game-overlay-card">
                        <div class="game-overlay-badge">THREE.JS 3D ARCADE</div>
                        <h3 class="game-overlay-title">Neon Slope</h3>
                        <p class="game-overlay-desc">
                            Roll down an endless high-speed neon slope. Dodge deadly red spikes, leap over gaps, and collect glowing power crystals!
                        </p>
                        <button type="button" class="btn btn-primary game-play-btn" id="slope-start-btn">
                            Play Neon Slope
                        </button>
                        <div class="game-overlay-keys">
                            <span><kbd>←</kbd> <kbd>→</kbd> or <kbd>A</kbd> <kbd>D</kbd> / Touch Steer</span>
                            <span><kbd>Space</kbd> / <kbd>↑</kbd> Jump</span>
                            <span><kbd>R</kbd> Restart</span>
                        </div>
                    </div>
                </div>

                <div class="game-overlay" id="slope-over-overlay" hidden>
                    <div class="game-overlay-card is-gameover">
                        <div class="game-record-banner" id="slope-record-banner" hidden>
                            NEW PERSONAL RECORD!
                        </div>
                        <div class="game-overlay-badge" id="slope-over-badge">RUN FINISHED</div>
                        <h3 class="game-overlay-title" id="slope-over-title">Crashed Out</h3>
                        <div class="game-over-grid">
                            <div class="game-over-stat">
                                <span class="game-over-label">Score</span>
                                <strong class="game-over-val is-primary" id="slope-over-score">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Max Streak</span>
                                <strong class="game-over-val" id="slope-over-combo">×0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Your Best</span>
                                <strong class="game-over-val" id="slope-over-best">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Global Rank</span>
                                <strong class="game-over-val" id="slope-over-rank">—</strong>
                            </div>
                        </div>
                        <p class="game-save-status" id="slope-save-status">Saving score…</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-primary game-play-btn" id="slope-again-btn">
                                Play Again
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="n2048-stage" id="neon2048-stage" hidden>
            <div class="n2048-toolbar">
                <div class="n2048-toolbar-left">
                    <span class="game-stat-pill n2048-stat-pill" title="Current Score">
                        Score <strong id="n2048-score">0</strong>
                    </span>
                    <span class="game-stat-pill n2048-stat-pill is-tile" title="Highest Tile Achieved">
                        Max Tile <strong id="n2048-max-tile">2</strong>
                    </span>
                    <span class="game-stat-pill n2048-stat-pill" title="Total Moves">
                        Moves <strong id="n2048-moves">0</strong>
                    </span>
                </div>
                <div class="n2048-toolbar-right">
                    <button type="button" class="btn btn-sm n2048-tool-btn" id="n2048-undo-btn" title="Undo last move" disabled>
                        ↩ Undo
                    </button>
                    <button type="button" class="btn btn-sm n2048-tool-btn" id="n2048-reset-btn" title="New Game (R)">
                        ↺ New
                    </button>
                </div>
            </div>

            <div class="n2048-arena">
                <div class="n2048-board-wrap">
                    <div class="n2048-board" id="n2048-board" tabindex="0" role="grid" aria-label="4 by 4 2048 Neon grid">
                        <!-- 16 cells rendered dynamically -->
                    </div>

                    <div class="n2048-dpad" aria-label="On-screen directional controls">
                        <button type="button" class="n2048-dpad-btn is-up" data-dir="up" aria-label="Move Up">▲</button>
                        <div class="n2048-dpad-row">
                            <button type="button" class="n2048-dpad-btn is-left" data-dir="left" aria-label="Move Left">◀</button>
                            <button type="button" class="n2048-dpad-btn is-down" data-dir="down" aria-label="Move Down">▼</button>
                            <button type="button" class="n2048-dpad-btn is-right" data-dir="right" aria-label="Move Right">▶</button>
                        </div>
                    </div>
                </div>

                <div class="game-overlay" id="n2048-start-overlay">
                    <div class="game-overlay-card">
                        <div class="game-overlay-badge">4×4 NEON GRID PUZZLE</div>
                        <h3 class="game-overlay-title">2048 Neon</h3>
                        <p class="game-overlay-desc">
                            Slide glowing number tiles across the grid. Identical numbers fuse into higher powers of 2. Reach the legendary <strong>2048</strong> cyber tile!
                        </p>
                        <button type="button" class="btn btn-primary game-play-btn" id="n2048-start-btn">
                            Play 2048 Neon
                        </button>
                        <div class="game-overlay-keys">
                            <span><kbd>Swipe</kbd> / <kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd> / <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> Slide</span>
                            <span><kbd>R</kbd> Restart</span>
                        </div>
                    </div>
                </div>

                <div class="game-overlay" id="n2048-win-overlay" hidden>
                    <div class="game-overlay-card is-gameover">
                        <div class="game-record-banner" id="n2048-win-record-banner" hidden>
                            NEW PERSONAL RECORD!
                        </div>
                        <div class="game-overlay-badge" style="background:#10b981;color:#fff;">CYBER 2048 REACHED!</div>
                        <h3 class="game-overlay-title">Matrix Ascended!</h3>
                        <p class="game-overlay-desc">You created the legendary 2048 neon tile. You can keep playing to push your score higher, or start a fresh round!</p>
                        <div class="game-over-grid">
                            <div class="game-over-stat">
                                <span class="game-over-label">Score</span>
                                <strong class="game-over-val is-primary" id="n2048-win-score">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Max Tile</span>
                                <strong class="game-over-val" id="n2048-win-tile">2048</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Your Best</span>
                                <strong class="game-over-val" id="n2048-win-best">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Global Rank</span>
                                <strong class="game-over-val" id="n2048-win-rank">—</strong>
                            </div>
                        </div>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-primary game-play-btn" id="n2048-keep-going-btn">
                                Keep Playing
                            </button>
                            <button type="button" class="btn btn-outline-light" id="n2048-win-again-btn">
                                Play Again
                            </button>
                        </div>
                    </div>
                </div>

                <div class="game-overlay" id="n2048-over-overlay" hidden>
                    <div class="game-overlay-card is-gameover">
                        <div class="game-record-banner" id="n2048-record-banner" hidden>
                            NEW PERSONAL RECORD!
                        </div>
                        <div class="game-overlay-badge">NO MOVES REMAINING</div>
                        <h3 class="game-overlay-title">Grid Locked</h3>
                        <div class="game-over-grid">
                            <div class="game-over-stat">
                                <span class="game-over-label">Score</span>
                                <strong class="game-over-val is-primary" id="n2048-over-score">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Max Tile</span>
                                <strong class="game-over-val" id="n2048-over-tile">2</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Your Best</span>
                                <strong class="game-over-val" id="n2048-over-best">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Global Rank</span>
                                <strong class="game-over-val" id="n2048-over-rank">—</strong>
                            </div>
                        </div>
                        <p class="game-save-status" id="n2048-save-status">Saving score…</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-primary game-play-btn" id="n2048-again-btn">
                                Play Again
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <aside class="card game-board-card" aria-label="Global High Scores">
        <div class="card-body">
            <div class="game-board-head">
                <div class="d-flex align-items-center gap-2">
                    <span class="game-trophy-icon" aria-hidden="true">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    </span>
                    <div>
                        <h2 class="h6 mb-0">Global High Scores</h2>
                        <span class="game-board-sub" id="board-summary">Loading leaderboard…</span>
                    </div>
                </div>
                <button type="button" class="icon-btn" id="board-refresh-btn" title="Refresh scores" aria-label="Refresh scores">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.2-5.5"/><path d="M20 4v5h-5"/></svg>
                </button>
            </div>

            <div id="board-alert" class="alert alert-danger py-2 px-3 small mb-2" role="alert" hidden></div>

            <div class="game-board-list" id="board-list">
                <p class="empty">Loading high scores…</p>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <script src="~/lib/three/three.min.js" asp-append-version="true"></script>
    <script src="~/js/games.js" asp-append-version="true"></script>
}

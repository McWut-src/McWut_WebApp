                        <div class="text-start mb-2">
                            <label for="ww-pub-title" class="form-label small text-white-50 mb-1">Level Name</label>
                            <input type="text" class="form-control form-control-sm ww-dark-input" id="ww-pub-title" maxlength="80" placeholder="e.g. Triple Loop Canyon" />
                        </div>
                        <div class="text-start mb-3">
                            <label for="ww-pub-desc" class="form-label small text-white-50 mb-1">Challenge Note (optional)</label>

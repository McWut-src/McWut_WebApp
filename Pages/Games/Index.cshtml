                                Play Again
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ww-stage" id="wheels-stage" hidden>
            <div class="ww-mode-bar">
                <div class="ww-mode-tabs" role="tablist" aria-label="Wacky Wheels modes">

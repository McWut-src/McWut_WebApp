                        </div>
                        <div class="text-start mb-3">
                            <label for="ww-pub-desc" class="form-label small text-white-50 mb-1">Challenge Note (optional)</label>
                            <input type="text" class="form-control form-control-sm ww-dark-input" id="ww-pub-desc" maxlength="240" placeholder="e.g. Hit Eject off the booster ramp to grab the top star!" />
                        </div>
                        <div class="alert alert-danger py-1 px-2 small mb-2" id="ww-pub-error" hidden></div>
                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                            <button type="button" class="btn btn-primary game-play-btn" id="ww-pub-submit-btn">
                                &#x1F680; Publish Level
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info" id="ww-pub-copy-btn" hidden>
                                Save as New Copy
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-light" id="ww-pub-cancel-btn">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cb-stage" id="breakout-stage" hidden>
            <div class="cb-toolbar">
                <div class="cb-toolbar-stats" aria-live="off">
                    <span class="game-stat-pill cb-stat-pill" title="Current Score">
                        Score <strong id="cb-hud-score">0</strong>
                    </span>
                    <span class="game-stat-pill cb-stat-pill" title="Combo Multiplier">
                        Mult <strong id="cb-hud-mult">x1</strong>
                    </span>
                    <span class="game-stat-pill cb-stat-pill is-combo" title="Current Combo Streak">
                        Combo <strong id="cb-hud-combo">0</strong>
                    </span>
                </div>
                <div class="cb-toolbar-actions">
                    <button type="button" class="btn btn-sm btn-outline-info cb-restart-btn" id="cb-btn-restart" title="Quick Restart (R)">
                        &#x27F2; <span>Restart</span>
                    </button>
                </div>
            </div>

            <div class="cb-viewport" id="breakout-viewport">
                <div class="game-overlay" id="breakout-start-overlay">
                    <div class="game-overlay-card">
                        <div class="game-overlay-badge">SYNTHWAVE ARCADE</div>
                        <h3 class="game-overlay-title">Cyber Breakout</h3>
                        <p class="game-overlay-desc">
                            Shatter neon brick matrices with arcade deflection physics. Trigger explosive chain reactions, collect multiballs, and unleash twin lasers!
                        </p>
                        <button type="button" class="btn btn-primary game-play-btn" id="breakout-start-btn">
                            Play Cyber Breakout
                        </button>
                        <div class="game-overlay-keys">
                            <span><kbd>Mouse</kbd> / Touch / <kbd>A</kbd><kbd>D</kbd> Steer</span>
                            <span><kbd>Space</kbd> / Tap Launch & Fire</span>
                            <span><kbd>R</kbd> Restart</span>
                        </div>
                    </div>
                </div>

                <div class="game-overlay" id="breakout-over-overlay" hidden>
                    <div class="game-overlay-card is-gameover">
                        <div class="game-record-banner" id="breakout-record-banner" hidden>
                            NEW PERSONAL RECORD!
                        </div>
                        <div class="game-overlay-badge" id="breakout-over-badge">RUN COMPLETED</div>
                        <h3 class="game-overlay-title" id="breakout-over-title">Game Over</h3>
                        <div class="game-over-grid">
                            <div class="game-over-stat">
                                <span class="game-over-label">Score</span>
                                <strong class="game-over-val is-primary" id="breakout-over-score">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Max Combo</span>
                                <strong class="game-over-val" id="breakout-over-combo">&times;0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Your Best</span>
                                <strong class="game-over-val" id="breakout-over-best">0</strong>
                            </div>
                            <div class="game-over-stat">
                                <span class="game-over-label">Global Rank</span>
                                <strong class="game-over-val" id="breakout-over-rank">&mdash;</strong>
                            </div>
                        </div>
                        <p class="game-save-status" id="breakout-save-status">Saving score&hellip;</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-primary game-play-btn" id="breakout-again-btn">
                                Play Again
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <aside class="card game-board-card" aria-label="Global High Scores">
        <div class="card-body">
            <div class="game-board-head">
                <div class="d-flex align-items-center gap-2">
                    <span class="game-trophy-icon" aria-hidden="true">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    </span>
                    <div>
                        <h2 class="h6 mb-0">Global High Scores</h2>
                        <span class="game-board-sub" id="board-summary">Loading leaderboard&hellip;</span>
                    </div>
                </div>
                <button type="button" class="icon-btn" id="board-refresh-btn" title="Refresh scores" aria-label="Refresh scores">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.2-5.5"/><path d="M20 4v5h-5"/></svg>
                </button>
            </div>

            <div id="board-alert" class="alert alert-danger py-2 px-3 small mb-2" role="alert" hidden></div>

            <div class="game-board-list" id="board-list">
                <p class="empty">Loading high scores…</p>
            </div>
        </div>
    </aside>
    </div>
</div>

@section Scripts {
    <script src="~/lib/three/three.min.js" asp-append-version="true"></script>
    <script src="~/js/games.js" asp-append-version="true"></script>
}

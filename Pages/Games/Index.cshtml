                            <span class="ww-btn-sub">Brake</span>
                        </button>
                        <button type="button" class="ww-touch-btn is-gas" id="ww-btn-gas" title="Accelerate / Gas (W or Up)" aria-label="Accelerate">
                            <span class="ww-btn-glyph">▲</span>
                            <span class="ww-btn-sub">Gas</span>
                        </button>
                    </div>
                </div>

                <div class="game-overlay" id="ww-start-overlay">
                    <div class="game-overlay-card">

            </div>

            <div class="ww-editor-toolbar" id="ww-editor-toolbar" hidden>
                <div class="ww-tool-palette" id="ww-tool-palette" role="toolbar" aria-label="Level editor tools">
                    <button type="button" class="ww-tool-btn is-active" data-ww-tool="road" title="Click and drag to draw hills, ramps, or floating roads">⛰ Road</button>
                    <button type="button" class="ww-tool-btn" data-ww-tool="boost" title="Draw glowing turbo-boosted road or launch ramps">⚡ Boost</button>
                    <button type="button" class="ww-tool-btn" data-ww-tool="loop" title="Tap to stamp a 360° Loop-the-Loop">🔄 Loop</button>
                    <button type="button" class="ww-tool-btn" data-ww-tool="spring" title="Tap to place a bouncy Springboard">⏫ Spring</button>
                    <button type="button" class="ww-tool-btn" data-ww-tool="ball" title="Tap to hang a Swinging Wrecking Ball">💣 Wrecking</button>
                    <button type="button" class="ww-tool-btn" data-ww-tool="crate" title="Tap to stack breakable wooden crates">📦 Crate</button>
                    <button type="button" class="ww-tool-btn" data-ww-tool="star" title="Tap to place +100 pt Bonus Stars">★ Star</button>
                    <button type="button" class="ww-tool-btn" data-ww-tool="finish" title="Tap to move the Checkered Finish Gate">🏁 Finish</button>
                    <button type="button" class="ww-tool-btn" data-ww-tool="pan" title="Drag canvas to pan view">✋ Pan</button>
                    <button type="button" class="ww-tool-btn is-danger" data-ww-tool="erase" title="Tap or drag to erase roads or obstacles">⌫ Erase</button>
                </div>
                <div class="ww-editor-actions">
                    <button type="button" class="btn btn-sm ww-ed-act-btn" id="ww-ed-pan-left" title="Scroll Left" aria-label="Scroll Left">◀</button>
                    <button type="button" class="btn btn-sm ww-ed-act-btn" id="ww-ed-pan-right" title="Scroll Right" aria-label="Scroll Right">▶</button>
                    <button type="button" class="btn btn-sm ww-ed-act-btn" id="ww-ed-undo-btn" title="Undo last edit" disabled>↩ Undo</button>
                    <button type="button" class="btn btn-sm ww-ed-act-btn" id="ww-ed-clear-btn" title="Reset to blank starter track">🧹 Clear</button>
                    <button type="button" class="btn btn-sm ww-ed-act-btn is-test" id="ww-ed-test-btn" title="Test drive your custom course">▶ Test</button>
                    <button type="button" class="btn btn-sm ww-ed-act-btn is-publish" id="ww-ed-publish-btn" title="Publish for other members to play">🚀 Publish</button>
                </div>
            </div>

            <div class="ww-toolbar" id="ww-telemetry-bar" aria-live="off">
                <div class="ww-toolbar-stats">
                    <span class="game-stat-pill ww-stat-pill" title="Elapsed Run Time">
                        ⏱ <strong id="ww-hud-timer">0:00.0</strong>
                    </span>
                    <span class="game-stat-pill ww-stat-pill is-dist" title="Course Progress & Distance">
                        <span>🏁</span>
                        <strong id="ww-hud-distance">0%</strong>
                        <span class="ww-mini-track" aria-hidden="true"><span class="ww-mini-fill" id="ww-hud-progress"></span></span>
                    </span>
                    <span class="game-stat-pill ww-stat-pill is-stars" title="Bonus Stars Collected (+100 pts each)">
                        ★ <strong id="ww-hud-stars">0/15</strong>
                    </span>
                    <span class="game-stat-pill ww-stat-pill is-combo" title="Flip & Airtime Combo Streak">
                        Combo <strong id="ww-hud-combo">×0</strong>
                    </span>
                    <span class="game-stat-pill ww-stat-pill" title="Vehicle Speed">
                        <strong id="ww-hud-speed">0</strong> <span>km/h</span>
                    </span>
                </div>
                <div class="ww-toolbar-actions">
                    <button type="button" class="btn btn-sm ww-restart-pill is-edit-return" id="ww-return-edit-btn" hidden title="Return to Level Editor">
                        ✎ <span>Edit Track</span>
                    </button>
                    <button type="button" class="btn btn-sm ww-restart-pill" id="ww-restart-btn" title="Quick Restart (R)" aria-label="Quick Restart">
                        ⟲ <span>Restart</span>
                    </button>
                </div>
            </div>

            <div class="ww-viewport" id="ww-viewport">
                <canvas id="ww-canvas" aria-label="Wacky Wheels 2D ragdoll physics obstacle course"></canvas>

                <div class="ww-center-hud" id="ww-center-hud" aria-live="polite">
                    <div class="ww-score-readout" id="ww-hud-score">0</div>
                    <div class="game-hud-combo ww-streak-pill" id="ww-streak-pill" hidden>FLIP STREAK ×1</div>
                    <div class="game-hud-pop ww-pop-banner" id="ww-pop-banner" hidden>BACKFLIP!</div>
                </div>

                <div class="ww-editor-hint-pill" id="ww-editor-hint" hidden>
                    Drag on canvas to draw smooth roads & hills · Click <strong>▶ Test</strong> anytime to drive!
                </div>

                <div class="ww-touch-pad" id="ww-touch-pad" role="group" aria-label="Touch vehicle controls">
                    <div class="ww-touch-cluster is-left">
                        <button type="button" class="ww-touch-btn is-tilt" id="ww-btn-left" title="Lean Back / Wheelie (A or Left)" aria-label="Tilt Left">
                            <span class="ww-btn-glyph">↺</span>
                            <span class="ww-btn-sub">Tilt L</span>
                        </button>
                        <button type="button" class="ww-touch-btn is-tilt" id="ww-btn-right" title="Lean Forward (D or Right)" aria-label="Tilt Right">
                            <span class="ww-btn-glyph">↻</span>
                            <span class="ww-btn-sub">Tilt R</span>
                        </button>
                    </div>
                    <div class="ww-touch-cluster is-right">
                        <button type="button" class="ww-touch-btn is-eject" id="ww-btn-eject" title="Eject Ragdoll / Super Boost (Space)" aria-label="Eject Ragdoll or Super Boost">
                            <span class="ww-btn-glyph">🚀</span>
                            <span class="ww-btn-sub">Eject</span>
                        </button>
                        <button type="button" class="ww-touch-btn is-brake" id="ww-btn-brake" title="Brake / Reverse (S or Down)" aria-label="Brake or Reverse">

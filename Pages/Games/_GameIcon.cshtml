@model string

@switch (Model)
{
    case "stack-3d":
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <polygon points="16,4 28,10 16,16 4,10" fill="#38bdf8" />
            <polygon points="4,10 16,16 16,21 4,15" fill="#0284c7" />
            <polygon points="28,10 16,16 16,21 28,15" fill="#0369a1" />
            <polygon points="16,13 26,18 16,23 6,18" fill="#a855f7" opacity="0.9" />
            <polygon points="6,18 16,23 16,28 6,23" fill="#7e22ce" />
            <polygon points="26,18 16,23 16,28 26,23" fill="#6b21a8" />
        </svg>
        break;

    case "mini-crossword":
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect x="4" y="4" width="11" height="11" rx="2.5" fill="#f43f5e" />
            <rect x="17" y="4" width="11" height="11" rx="2.5" fill="#fb7185" opacity="0.85" />
            <rect x="4" y="17" width="11" height="11" rx="2.5" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
            <rect x="17" y="17" width="11" height="11" rx="2.5" fill="#f59e0b" />
            <text x="9.5" y="12.5" text-anchor="middle" fill="#ffffff" font-size="8" font-weight="800" font-family="sans-serif">A</text>
            <text x="22.5" y="12.5" text-anchor="middle" fill="#ffffff" font-size="8" font-weight="800" font-family="sans-serif">B</text>
            <text x="22.5" y="25.5" text-anchor="middle" fill="#ffffff" font-size="8" font-weight="800" font-family="sans-serif">C</text>
        </svg>
        break;

    case "minesweeper":
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path d="M4 10h24M4 16h24M4 22h24M10 4v24M16 4v24M22 4v24" stroke="#38bdf8" stroke-width="0.8" opacity="0.14" />
            <circle cx="16" cy="18" r="5.6" fill="#111c2e" stroke="#fb7185" stroke-width="1.7" />
            <path d="M16 9.6V6.4M16 29.6v-3.2M6.4 18H3.2M28.8 18h-3.2M9.3 11.3l-2.2-2.2M22.7 11.3l2.2-2.2M9.3 24.7l-2.2 2.2M22.7 24.7l2.2 2.2" stroke="#fb7185" stroke-width="1.7" stroke-linecap="round" />
            <circle cx="16" cy="18" r="2.2" fill="#f43f5e" />
            <path d="M19.2 14.8l2-2" stroke="#fbbf24" stroke-width="1.6" stroke-linecap="round" />
            <circle cx="21.8" cy="12.2" r="1.1" fill="#fbbf24" />
        </svg>
        break;

    case "neon-slope":
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path d="M4 26L13 8h6l9 18" stroke="#22d3ee" stroke-width="2" stroke-linecap="round"/>
            <circle cx="16" cy="19" r="4.5" fill="#f43f5e"/>
        </svg>
        break;

    case "merge-2048":
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect x="5" y="5" width="10" height="10" rx="2.5" fill="#f59e0b"/>
            <rect x="17" y="5" width="10" height="10" rx="2.5" fill="#fbbf24" opacity="0.65"/>
            <rect x="5" y="17" width="10" height="10" rx="2.5" fill="#fbbf24" opacity="0.4"/>
            <rect x="17" y="17" width="10" height="10" rx="2.5" fill="#10b981"/>
        </svg>
        break;

    case "wacky-wheels":
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path d="M3 26c5 0 7-4 13-4s8 4 13 4" stroke="#22c55e" stroke-width="2" stroke-linecap="round" opacity="0.55" />
            <circle cx="10" cy="21" r="4.2" fill="#0f172a" stroke="#facc15" stroke-width="2" />
            <circle cx="22" cy="19" r="4.2" fill="#0f172a" stroke="#facc15" stroke-width="2" />
            <path d="M9 19l5-4h7l2 3" stroke="#ef4444" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="15" cy="9.5" r="3" fill="#fde047" stroke="#38bdf8" stroke-width="1.4" />
            <path d="M15 12.5l-1 4.5M14.5 14l4.5 1" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" />
            <polygon points="26,5 27,7.4 29.6,7.6 27.6,9.2 28.2,11.7 26,10.3 23.8,11.7 24.4,9.2 22.4,7.6 25,7.4" fill="#facc15" />
        </svg>
        break;

    case "brick-breaker":
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect x="4" y="6" width="6" height="3" rx="1" fill="#ec4899" />
            <rect x="13" y="6" width="6" height="3" rx="1" fill="#a855f7" />
            <rect x="22" y="6" width="6" height="3" rx="1" fill="#6366f1" />
            <rect x="4" y="11" width="6" height="3" rx="1" fill="#38bdf8" />
            <rect x="13" y="11" width="6" height="3" rx="1" fill="#22c55e" />
            <rect x="22" y="11" width="6" height="3" rx="1" fill="#eab308" />
            <circle cx="16" cy="18" r="2" fill="#ffffff" />
            <rect x="10" y="24" width="12" height="3" rx="1.5" fill="#38bdf8" />
        </svg>
        break;

    case "hextris":
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <polygon points="16,8 24,12.5 24,21.5 16,26 8,21.5 8,12.5" stroke="#a855f7" stroke-width="1.8" fill="#110d24" />
            <path d="M16 4l10 5.8v11.6L16 27 6 21.4V9.8L16 4z" stroke="#06b6d4" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.45" />
            <path d="M12 10.2l4-2.3 4 2.3" stroke="#00f0ff" stroke-width="2.2" stroke-linecap="round" />
            <path d="M22 13.5l2 3.5-2 3.5" stroke="#ff007f" stroke-width="2.2" stroke-linecap="round" />
            <path d="M20 22.8l-4 2.3-4-2.3" stroke="#00ff66" stroke-width="2.2" stroke-linecap="round" />
            <path d="M10 20.5l-2-3.5 2-3.5" stroke="#ffb700" stroke-width="2.2" stroke-linecap="round" />
            <circle cx="16" cy="17" r="2.5" fill="#a855f7" />
        </svg>
        break;

    case "meme-merge":
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <circle cx="16" cy="18" r="11" fill="#facc15" stroke="#ca8a04" stroke-width="1.2" />
            <path d="M11 15.5 Q14 14.5 16 15.5" stroke="#1e293b" stroke-width="1.2" stroke-linecap="round" />
            <path d="M17 13 Q20 11 23 14" stroke="#1e293b" stroke-width="1.4" stroke-linecap="round" />
            <circle cx="14" cy="17.5" r="1.3" fill="#1e293b" />
            <circle cx="21" cy="17" r="1.6" fill="#1e293b" />
            <path d="M13 22 Q16 23.5 20 21.5" stroke="#1e293b" stroke-width="1.1" stroke-linecap="round" />
            <circle cx="8" cy="7" r="3.2" fill="#8b5cf6" stroke="#ffffff" stroke-width="0.8" />
            <circle cx="16" cy="5" r="4.2" fill="#06b6d4" stroke="#ffffff" stroke-width="0.8" />
            <circle cx="24" cy="7" r="3.5" fill="#10b981" stroke="#ffffff" stroke-width="0.8" />
            <polygon points="16,9.5 16.6,11 18,11.2 17,12.2 17.3,13.5 16,12.8 14.7,13.5 15,12.2 14,11.2 15.4,11" fill="#ffffff" />
        </svg>
        break;

    case "godzilla-rampage":
    default:
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <!-- Sweeping layered voxel dragon tail -->
            <path d="M21 19l9 2-3.5 2.5 3.5 2-6 1.2-3.5-2.7z" fill="#4c6b45" stroke="#31472c" stroke-width="0.7" />
            <path d="M22 22l5.5 1.8-2.8 1.6z" fill="#6b8e5e" />
            <!-- Stubby clawed arms raised -->
            <path d="M6.5 13L3 9.5l1.3-1.2 1 1 1-1.3 1.4 1.3-0.7 1.3 1.8 1z" fill="#6f925f" />
            <path d="M24 12.5l3.3-3.5-1.3-1.1-1 1-1-1.2-1.3 1.2.7 1.3-1.7 1z" fill="#6f925f" />
            <!-- Stubby clawed legs -->
            <path d="M9.5 23.5l-2.5 4.2 1.4.4.9-1.2.6 1.4 1.4-.2 1.2-3.6z" fill="#5b7d4e" />
            <path d="M20.5 23.5l2.2 4.2-1.4.4-.8-1.2-.6 1.4-1.4-.2-1-3.6z" fill="#5b7d4e" />
            <!-- Spherical mossy voxel orb body -->
            <circle cx="15.5" cy="16" r="9.2" fill="#577a4d" stroke="#375132" stroke-width="1.2" />
            <path d="M10.5 9.2h2v1.5h2v-1.2h2v1.2h2v-1.5h1.5" stroke="#7ea06b" stroke-width="1.3" stroke-linecap="square" />
            <!-- Furious glowing molten eyes -->
            <polygon points="10.2,12 13.8,13.1 10.6,14.2" fill="#ff5a00" />
            <polygon points="20.8,12 17.2,13.1 20.4,14.2" fill="#ff5a00" />
            <circle cx="11.8" cy="13.1" r="0.9" fill="#fef08a" />
            <circle cx="19.2" cy="13.1" r="0.9" fill="#fef08a" />
            <!-- Giant open roaring maw & jagged ivory fangs -->
            <ellipse cx="15.5" cy="19.2" rx="5.2" ry="4.4" fill="#170305" stroke="#62171b" stroke-width="1.2" />
            <polygon points="11.5,16 12.6,18 13.7,16" fill="#f7f2d7" />
            <polygon points="14.2,15.5 15.5,17.8 16.8,15.5" fill="#f7f2d7" />
            <polygon points="17.3,16 18.4,18 19.5,16" fill="#f7f2d7" />
            <polygon points="12.1,22.2 13.1,20.2 14.1,22.2" fill="#f7f2d7" />
            <polygon points="14.6,22.6 15.5,20.4 16.4,22.6" fill="#f7f2d7" />
            <polygon points="16.9,22.2 17.9,20.2 18.9,22.2" fill="#f7f2d7" />
            <!-- Tiny ember sparks -->
            <rect x="4" y="18" width="1.4" height="1.4" fill="#fb923c" />
            <rect x="26.5" y="15" width="1.4" height="1.4" fill="#fde047" />
        </svg>
        break;
}

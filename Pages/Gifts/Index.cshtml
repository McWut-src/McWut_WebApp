@page
@model McWutWebApp.Pages.Gifts.IndexModel
@{
    ViewData["Title"] = "Gift Lists";
    ViewData["ShownName"] = Model.CurrentUserName;
}

<div class="gifts-page" id="gifts-page" data-current-user-id="@Model.CurrentUserId" data-current-user-name="@Model.CurrentUserName" data-current-user-color="@(Model.CurrentUserColor ?? "#0b1f3a")">
    <div class="gifts-hero">
        <div class="gifts-hero-content">
            <div class="gifts-hero-badge">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                <span>Gift Lists</span>
            </div>
            <h1 class="gifts-title">Gift Lists</h1>
            <p class="gifts-subtitle">
                Create your gift list! Share whatever you want &mdash; a link, an image, text, a voice note, or a drawing, each as an item on your list.
            </p>
        </div>
    </div>

    <!-- Family Members Bar -->
    <div class="gifts-section-label">Family Gift Lists</div>
    <div class="gifts-members-carousel" id="gifts-members-list" role="tablist" aria-label="Family Gift Lists">
        <div class="gifts-loading-pill">Loading family...</div>
    </div>

    <!-- Active List Container -->
    <div class="gifts-list-container" id="gifts-list-container">
        <div class="gifts-list-head" id="gifts-list-head">
            <div class="gifts-list-owner">
                <span class="gifts-owner-dot" id="gifts-active-dot" aria-hidden="true"></span>
                <h2 class="gifts-active-name" id="gifts-active-name">My Gift List</h2>
                <span class="gifts-kid-badge d-none" id="gifts-active-kid-badge">Kid</span>
            </div>
            <div class="gifts-list-stats">
                <span class="gifts-count-chip" id="gifts-active-count">0 items</span>
            </div>
        </div>

        <!-- Add / Drop Composer (shown for own list) -->
        <div class="gifts-composer-card" id="gifts-composer">
            <div class="gifts-composer-top">
                <div class="gifts-composer-title">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                    <span>Add an Item to Your List</span>
                </div>
                <span class="gifts-drop-hint">Share text, a URL, an image, a voice recording, or a drawing</span>
            </div>

            <!-- Drop Zone Target -->
            <div class="gifts-dropzone" id="gifts-dropzone">
                <div class="gifts-dropzone-inner">
                    <svg class="icon drop-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V6"/><path d="M8 9l4-4 4 4"/><path d="M5 19h14"/></svg>
                    <span>Drop an image, audio file, link, or text here</span>
                </div>
            </div>

            <form id="gift-add-form" class="gifts-form" autocomplete="off">
                <div class="gifts-field">
                    <label for="gift-title" class="form-label visually-hidden">Item text or title</label>
                    <input type="text" id="gift-title" class="form-control gift-title-input" placeholder="Write text or what you want (optional if adding a link, image, voice, or drawing)" maxlength="200" />
                </div>

                <div class="gifts-row">
                    <div class="gifts-field flex-grow-1">
                        <label for="gift-url" class="form-label visually-hidden">Web link / URL</label>
                        <div class="input-group">
                            <span class="input-group-text gift-input-icon">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2a5 5 0 0 0 7.1 7.1l1.1-1.1"/></svg>
                            </span>
                            <input type="text" inputmode="url" id="gift-url" class="form-control" placeholder="Paste a link / URL (optional, e.g. amazon.com/...)" maxlength="2048" />
                        </div>
                    </div>
                </div>

                <div class="gifts-field">
                    <label for="gift-desc" class="form-label visually-hidden">Extra notes or details</label>
                    <textarea id="gift-desc" class="form-control gift-desc-input" rows="2" placeholder="Extra notes or details (optional)" maxlength="2000"></textarea>
                </div>

                <!-- Inline Voice Recording Bar -->
                <div class="gift-voice-bar d-none" id="gift-voice-bar">
                    <div class="gift-voice-status">
                        <span class="gift-voice-dot" aria-hidden="true"></span>
                        <span>Recording voice...</span>
                        <span class="gift-voice-timer" id="gift-voice-timer">0:00</span>
                    </div>
                    <div class="gift-voice-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="gift-voice-cancel">Cancel</button>
                        <button type="button" class="btn btn-sm btn-danger" id="gift-voice-stop">Stop &amp; Attach</button>
                    </div>
                </div>

                <!-- Attachment preview (Image, Drawing, or Voice) -->
                <div class="gift-attachment-box d-none" id="gift-attachment-box">
                    <div class="gift-attachment-preview">
                        <img id="gift-attachment-thumb" src="" alt="Attached preview" class="gift-thumb-img d-none" />
                        <audio id="gift-attachment-audio" controls preload="metadata" class="gift-attach-audio d-none"></audio>
                        <div class="gift-attachment-meta">
                            <span class="gift-attachment-type" id="gift-attachment-type">Image</span>
                            <span class="gift-attachment-status" id="gift-attachment-status">Ready</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger gift-attach-clear" id="gift-attach-clear" title="Remove attachment" aria-label="Remove attachment">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6L6 18"/></svg>
                        </button>
                    </div>
                </div>

                <div class="gifts-composer-actions">
                    <div class="gifts-media-buttons">
                        <input type="file" id="gift-photo-input" accept="image/jpeg,image/png,image/gif,image/webp" class="visually-hidden" />
                        <button type="button" class="btn btn-sm btn-outline-secondary gift-media-btn" id="gift-photo-btn" title="Add image" aria-label="Add image">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M4 16l4.5-4.5a1.5 1.5 0 0 1 2.1 0L16 16"/><path d="M13 14l1.5-1.5a1.5 1.5 0 0 1 2.1 0L20 15"/></svg>
                            <span>Image</span>
                        </button>
                        <input type="file" id="gift-voice-input" accept="audio/*" class="visually-hidden" />
                        <button type="button" class="btn btn-sm btn-outline-secondary gift-media-btn" id="gift-voice-btn" title="Record or upload voice note" aria-label="Record or upload voice note">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><path d="M12 17v4"/><path d="M9 21h6"/></svg>
                            <span>Voice</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary gift-media-btn" id="gift-doodle-btn" title="Draw something or draw on a photo" aria-label="Drawing">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.4 3.6a2 2 0 0 1 2.8 2.8L11.5 16c-.8.8-2 1-3 1-1.7 0-3 1.3-3 3 0-.2-1.8-.8-1.8-2.8 0-1.9 1.5-3.4 3.4-3.6.8-.1 1.4-.5 2-1.1z"/></svg>
                            <span>Drawing</span>
                        </button>
                    </div>
                    <button type="submit" class="btn btn-primary gift-submit-btn" id="gift-submit-btn">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                        <span>Add Item</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- Gift List Items Grid -->
        <div class="gifts-grid" id="gifts-grid">
            <div class="gifts-empty-state" id="gifts-empty-state">
                <div class="gifts-empty-icon">🎁</div>
                <h3>No items on this gift list yet</h3>
                <p id="gifts-empty-msg">Add text, a URL, an image, a voice note, or a drawing above!</p>
            </div>
        </div>
    </div>
</div>

<!-- Doodle Canvas Drawing Modal (Supports Draw-on-Photo) -->
<div class="modal fade gifts-modal" id="gifts-doodle-modal" tabindex="-1" aria-labelledby="gifts-doodle-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2" id="gifts-doodle-title">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.4 3.6a2 2 0 0 1 2.8 2.8L11.5 16c-.8.8-2 1-3 1-1.7 0-3 1.3-3 3 0-.2-1.8-.8-1.8-2.8 0-1.9 1.5-3.4 3.4-3.6.8-.1 1.4-.5 2-1.1z"/></svg>
                    <span>Draw Anything</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-2 p-md-3">
                <div class="doodle-toolbar mb-2">
                    <div class="doodle-swatches" id="gifts-doodle-swatches" aria-label="Drawing color"></div>
                    <div class="doodle-sizes" id="gifts-doodle-sizes" aria-label="Brush size">
                        <button type="button" class="doodle-size-btn" data-size="3" title="Fine" aria-label="Fine brush"><span style="width:4px;height:4px"></span></button>
                        <button type="button" class="doodle-size-btn active" data-size="7" title="Medium" aria-label="Medium brush"><span style="width:7px;height:7px"></span></button>
                        <button type="button" class="doodle-size-btn" data-size="14" title="Bold" aria-label="Bold brush"><span style="width:12px;height:12px"></span></button>
                        <button type="button" class="doodle-size-btn" data-size="24" title="Thick" aria-label="Thick brush"><span style="width:18px;height:18px"></span></button>
                    </div>
                    <div class="doodle-tools">
                        <input type="file" id="gifts-doodle-bg-input" accept="image/jpeg,image/png,image/gif,image/webp" class="visually-hidden" />
                        <button type="button" class="btn btn-sm btn-outline-primary" id="gifts-doodle-bg-btn" title="Load a photo onto the background to draw or circle on it">
                            <svg class="icon me-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M4 16l4.5-4.5a1.5 1.5 0 0 1 2.1 0L16 16"/><path d="M13 14l1.5-1.5a1.5 1.5 0 0 1 2.1 0L20 15"/></svg>
                            <span>Photo BG</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="gifts-doodle-eraser" title="Eraser" aria-label="Eraser">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20H7L3 16a1.5 1.5 0 0 1 0-2.1L13.4 3.5a1.5 1.5 0 0 1 2.1 0l5 5a1.5 1.5 0 0 1 0 2.1L11.5 20"/></svg>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="gifts-doodle-undo" title="Undo" aria-label="Undo">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-15-6.7L3 13"/></svg>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="gifts-doodle-clear" title="Clear all" aria-label="Clear all">Clear</button>
                    </div>
                </div>

                <div class="doodle-stage-wrap">
                    <canvas id="gifts-doodle-bg" width="600" height="420" class="doodle-canvas-bg"></canvas>
                    <canvas id="gifts-doodle-draw" width="600" height="420" class="doodle-canvas-draw"></canvas>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="gifts-doodle-save-btn">
                    <span>Attach Drawing</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Image Lightbox Modal -->
<div class="modal fade gifts-modal" id="gifts-lightbox-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-body p-0 text-center position-relative">
                <button type="button" class="btn btn-sm btn-dark position-absolute top-0 end-0 m-2 rounded-circle" data-bs-dismiss="modal" aria-label="Close">✕</button>
                <img id="gifts-lightbox-img" src="" alt="Enlarged gift preview" class="img-fluid rounded shadow-lg" style="max-height:85vh;object-fit:contain;background:#fff;" />
            </div>
        </div>
    </div>
</div>

<!-- Edit Gift Modal -->
<div class="modal fade gifts-modal" id="gifts-edit-modal" tabindex="-1" aria-labelledby="gifts-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="gifts-edit-title">Edit Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="gifts-edit-form">
                <div class="modal-body">
                    <input type="hidden" id="edit-gift-id" />
                    <div class="mb-3">
                        <label for="edit-gift-title" class="form-label small fw-semibold">Text / Title (optional)</label>
                        <input type="text" id="edit-gift-title" class="form-control" maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label for="edit-gift-url" class="form-label small fw-semibold">Web Link / URL (optional)</label>
                        <input type="text" inputmode="url" id="edit-gift-url" class="form-control" maxlength="2048" />
                    </div>
                    <div class="mb-3">
                        <label for="edit-gift-desc" class="form-label small fw-semibold">Notes / Details (optional)</label>
                        <textarea id="edit-gift-desc" class="form-control" rows="2" maxlength="2000"></textarea>
                    </div>
                    <div class="form-check d-none" id="edit-gift-attachment-row">
                        <input class="form-check-input" type="checkbox" id="edit-gift-remove-attachment" />
                        <label class="form-check-label small text-danger fw-semibold" for="edit-gift-remove-attachment">
                            Remove attached image / voice / drawing
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm" id="edit-gift-save-btn">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/gifts.js" asp-append-version="true"></script>
}

@using FamilyVault.Files.Security
@using McWutWebApp.Hosting
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.AspNetCore.Identity.SignInManager<Microsoft.AspNetCore.Identity.IdentityUser> SignInManager
@inject FamilyVault.Files.Contracts.IFamilyRoster Roster
@inject FamilyVault.Files.Services.DirectMessageService DirectMessages
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var path = Context.Request.Path.Value ?? "";
    var publicChrome = path.StartsWith("/s/", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/s", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/join", StringComparison.OrdinalIgnoreCase);
    var personal = signedIn && !publicChrome;
    var bare = ViewData["Bare"] as bool? == true;
    var shownName = MemberNames.Shown(null, User.Identity?.Name);
    string? accent = null;
    var bar = MemberColors.Fallback;
    var barInk = MemberLabel.PaleInk;
    var barPale = false;
    var unreadMessages = 0;
    if (personal)
    {
        var id = User.GetVaultUserId();
        if (id is not null)
        {
            var member = await Roster.GetAsync(id.Value, Context.RequestAborted);
            shownName = MemberNames.Shown(member?.DisplayName, member?.Email ?? User.Identity?.Name);
            accent = MemberColors.Normalize(member?.AccentColor);
            unreadMessages = await DirectMessages.UnreadCountAsync(id.Value, Context.RequestAborted);
        }

        bar = accent ?? MemberColors.Fallback;
        barInk = MemberLabel.Ink(bar);
        barPale = MemberLabel.Pale(bar);
        ViewData["ShownName"] = shownName;
        ViewData["Accent"] = accent;
        ViewData["MessageUnread"] = unreadMessages;
    }

    var bodyClass = personal ? "is-auth" : "is-guest";
    if (bare)
    {
        bodyClass += " is-bare";
    }

    if (personal)
    {
        bodyClass += barPale ? " bar-pale" : " bar-dark";
    }

    var bodyStyle = personal ? $"--bar: {bar}; --bar-ink: {barInk};" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <script>
        try {
            if (localStorage.getItem("mcwut-nav") === "icons") {
                document.documentElement.classList.add("is-rail");
            }
            if (localStorage.getItem("mcwut-theme") === "dark") {
                document.documentElement.setAttribute("data-theme", "dark");
            }
        } catch (e) { }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@(personal ? bar : "#0b1f3a")" />
    <title>@(personal ? ViewData["Title"] : $"{ViewData["Title"]} - McWut")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.json" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/McWutWebApp.styles.css" asp-append-version="true" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
</head>
<body class="@bodyClass" style="@bodyStyle">
    <div class="app-shell">
        <header class="topbar">
            @if (personal)
            {
                <button class="top-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#app-menu" aria-controls="app-menu" aria-label="Open menu" title="Menu">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
                </button>
            }
            <a class="brand" asp-area="" asp-page="/Index">@(personal ? shownName : "McWut")</a>
            @if (personal)
            {
                <a class="top-icon d-lg-none" asp-page="/Vault/Index" title="My files" aria-label="My files">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
                </a>
                <a class="top-icon d-lg-none" asp-page="/Passwords/Index" title="Vault" aria-label="Vault">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                </a>
                <a class="top-icon d-lg-none" asp-page="/Urls/Index" title="URLs" aria-label="URLs">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2a5 5 0 0 0 7.1 7.1l1.1-1.1"/></svg>
                </a>
                <a class="top-icon d-lg-none" asp-page="/Messages/Index" title="Messages" aria-label="Messages">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9l-4 3v-3H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/></svg>
                    @if (unreadMessages > 0)
                    {
                        <span class="top-count"></span>
                    }
                </a>
                <a class="top-icon d-lg-none" asp-page="/Ai/Index" title="AI" aria-label="AI">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.4 4.2L17.6 8.6 13.4 10 12 14.2 10.6 10 6.4 8.6 10.6 7.2z"/><path d="M18 14.5l.6 1.6 1.6.6-1.6.6-.6 1.6-.6-1.6-1.6-.6 1.6-.6z"/></svg>
                </a>
                <a class="top-icon d-lg-none" asp-page="/Profile/Index" title="Profile" aria-label="Profile">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 19a7 7 0 0 1 14 0"/></svg>
                </a>
            }
        </header>
        @if (personal)
        {
            <aside class="sidebar">
                <button type="button" class="rail-toggle" id="rail-toggle" aria-pressed="false" title="Icons only" aria-label="Icons only">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg>
                </button>
                <partial name="_Nav" />
            </aside>
            <div class="offcanvas offcanvas-start" tabindex="-1" id="app-menu" aria-labelledby="app-menu-label">
                <div class="offcanvas-header">
                    <h2 class="offcanvas-title h6 mb-0" id="app-menu-label">@shownName</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column">
                    <partial name="_Nav" />
                </div>
            </div>
        }
        <div class="app-main">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/icons.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

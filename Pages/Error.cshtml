@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3">Something went wrong</h1>
<p class="text-muted">McWut could not complete that request. Try again, or go back to <a asp-page="/Index">home</a>.</p>

@if (Model.ShowRequestId)
{
    <p class="small text-muted mb-0">
        Request ID: <code>@Model.RequestId</code>
    </p>
}

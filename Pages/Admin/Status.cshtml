@page "/admin/status"
@model McWutWebApp.Pages.Admin.StatusModel
@{
    ViewData["Title"] = "Status";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Status</h1>
        <p class="page-kicker">This running site. <a href="/health">/health</a> still answers <code>ok</code>. No passwords or connection strings here.</p>
    </div>
</div>

@if (Model.Problem is not null)
{
    <div class="alert alert-danger">@Model.Problem</div>
}

<dl class="status-list panel">
    <div><dt>Environment</dt><dd>@Model.EnvironmentName</dd></div>
    <div><dt>Database</dt><dd>@Model.DatabaseProvider — @(Model.DatabaseOk ? "reachable" : "not reachable")</dd></div>
    <div><dt>File storage</dt><dd>@Model.StorageProvider</dd></div>
    <div><dt>Accounts</dt><dd>@Model.UserCount</dd></div>
    <div><dt>Files kept</dt><dd>@Model.FileCount</dd></div>
    <div><dt>Open invites</dt><dd>@Model.OpenInviteCount</dd></div>
</dl>

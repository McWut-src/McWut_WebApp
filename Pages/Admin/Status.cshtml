@page "/admin/status"
@model McWutWebApp.Pages.Admin.StatusModel
@{
    ViewData["Title"] = "Status";
}

<h1 class="h3 mb-3">Status</h1>
<p class="text-muted">A look at this running site. The public address <a href="/health">/health</a> still answers <code>ok</code> for the host. This page does not show passwords or connection strings.</p>

@if (Model.Problem is not null)
{
    <div class="alert alert-danger">@Model.Problem</div>
}

<dl class="row">
    <dt class="col-sm-3">Environment</dt>
    <dd class="col-sm-9">@Model.EnvironmentName</dd>
    <dt class="col-sm-3">Database</dt>
    <dd class="col-sm-9">@Model.DatabaseProvider — @(Model.DatabaseOk ? "reachable" : "not reachable")</dd>
    <dt class="col-sm-3">File storage</dt>
    <dd class="col-sm-9">@Model.StorageProvider</dd>
    <dt class="col-sm-3">Accounts</dt>
    <dd class="col-sm-9">@Model.UserCount</dd>
    <dt class="col-sm-3">Files kept</dt>
    <dd class="col-sm-9">@Model.FileCount</dd>
    <dt class="col-sm-3">Open invites</dt>
    <dd class="col-sm-9">@Model.OpenInviteCount</dd>
</dl>

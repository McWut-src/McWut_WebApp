@page "/admin/reset-password"
@model McWutWebApp.Pages.Admin.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h5 mb-3">Reset a sign-in password</h1>
                <p class="text-muted">Set a new McWut login password for someone. This is not a saved login in Passwords. Use at least @Model.RequiredLength characters. Turning an account off or on stays on <a asp-page="/Admin/People">People</a>.</p>
                @if (Model.Notice is not null)
                {
                    <div class="alert alert-success">@Model.Notice</div>
                }
                @if (Model.Error is not null)
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }
                <form method="post" autocomplete="off">
                    <div class="mb-3">
                        <label class="form-label" for="UserId">Person</label>
                        <select asp-for="UserId" class="form-select" asp-items="Model.Accounts" id="UserId">
                            <option value="">Choose…</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="NewPassword">New password</label>
                        <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="ConfirmPassword">Confirm new password</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary" onclick="return confirm('Reset this sign-in password? They will use the new password next time.');">Reset password</button>
                </form>
            </div>
        </div>
    </div>
</div>

{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/mcwut.db;Cache=Shared"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Identity": {
    "AllowRegistration": false,
    "SeedDemoUsers": false
  },
  "Files": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/vault"
    },
    "Azure": {
      "ConnectionString": "",
      "Container": "vault",
      "KeysContainer": "keys"
    },
    "DefaultRetentionDays": 7,
    "MaxFileSizeBytes": 104857600,
    "QuotaBytesPerUser": 1073741824,
    "SweepIntervalMinutes": 15,
    "AbandonedUploadHours": 24,
    "SoftDeleteGraceDays": 7,
    "AllowAnyContentType": true,
    "AllowedContentTypes": [
      "application/pdf",
      "application/octet-stream",
      "application/zip",
      "application/msword",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "text/plain",
      "video/mp4",
      "audio/mpeg"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
